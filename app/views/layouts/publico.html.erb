<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || branding_texto(:nombre_plataforma, "Copenet Enterprise") %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="application-name" content="<%= branding_texto(:nombre_plataforma, 'Copenet Enterprise') %>">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= branding_css_variables %>
    <%= javascript_importmap_tags %>
  </head>
  <body class="public-body" data-controller="loading">
    <%= render "shared/page_loader" %>
    <main class="public-main">
      <%= render "shared/flash" %>
      <%= yield %>
    </main>
  </body>
</html>
