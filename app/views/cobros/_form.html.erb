<%= form_with model: cobro, class: "company-form" do |form| %>
  <% if cobro.errors.any? %>
    <section class="panel form-errors">
      <ul class="error-list">
        <% cobro.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </section>
  <% end %>

  <section class="panel product-tabs-panel">
    <div class="panel-header">
      <div><h2>Configuración del cobro</h2></div>
      <div class="form-actions company-form-header-actions">
        <%= form.submit "Guardar", class: "ui-button ui-button-primary submit-button" %>
        <%= link_to "Cancelar", cobros_path, class: "ui-button ui-button-secondary" %>
      </div>
    </div>
  </section>

  <section class="panel form-section">
    <div class="panel-header"><div><h2>Información general</h2></div></div>
    <div class="form-grid">
      <div class="field-group">
        <%= form.label :referencia, "Referencia" %>
        <%= form.text_field :referencia, class: "text-input" %>
      </div>
      <div class="field-group">
        <%= form.label :cliente_id, "Cliente registrado" %>
        <%= form.select :cliente_id, options_from_collection_for_select(@clientes, :id, :nombre, cobro.cliente_id), { include_blank: "Seleccionar cliente" }, class: "text-input filter-select" %>
      </div>
      <div class="field-group">
        <%= form.label :cliente_nombre, "Nombre del cliente" %>
        <%= form.text_field :cliente_nombre, class: "text-input" %>
      </div>
      <div class="field-group">
        <%= form.label :gestor, "Gestor" %>
        <%= form.text_field :gestor, class: "text-input" %>
      </div>
      <div class="field-group">
        <%= form.label :fecha_vencimiento, "Fecha de vencimiento" %>
        <%= form.date_field :fecha_vencimiento, class: "text-input" %>
      </div>
      <div class="field-group">
        <%= form.label :fecha_pago, "Fecha de pago" %>
        <%= form.date_field :fecha_pago, class: "text-input" %>
      </div>
      <div class="field-group">
        <%= form.label :monto, "Monto" %>
        <%= form.number_field :monto, class: "text-input", min: 0, step: "0.01" %>
      </div>
      <div class="field-group">
        <%= form.label :moneda_id, "Moneda" %>
        <%= form.select :moneda_id, options_from_collection_for_select(@monedas, :id, :nombre, cobro.moneda_id), { include_blank: "Seleccionar moneda" }, class: "text-input filter-select" %>
      </div>
      <div class="field-group">
        <%= form.label :estado, "Estado" %>
        <%= form.select :estado, options_for_select(Cobro::ESTADOS.map { |estado| [estado.humanize, estado] }, cobro.estado), {}, class: "text-input filter-select" %>
      </div>
      <% if cobro.persisted? %>
        <div class="field-group checkbox-group">
          <label class="checkbox-label">
            <%= hidden_field_tag "cobro[activo]", "1" %>
            <%= check_box_tag "cobro[activo]", "0", !cobro.activo? %>
            <span>Inactivar</span>
          </label>
        </div>
      <% else %>
        <%= form.hidden_field :activo, value: true %>
      <% end %>
      <div class="field-group field-group-full">
        <%= form.label :notas, "Notas" %>
        <%= form.text_area :notas, rows: 4, class: "text-input text-area" %>
      </div>
    </div>
  </section>
<% end %>
