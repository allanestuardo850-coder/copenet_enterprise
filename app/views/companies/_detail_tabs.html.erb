<section class="panel user-tabs-panel" data-controller="tabs" data-tabs-default-value="<%= default_tab %>">
  <div class="module-tabs" role="tablist" aria-label="Secciones de la empresa">
    <button type="button" class="module-tab is-active" data-tabs-target="tab" data-tab-id="general" data-action="tabs#switch" role="tab" aria-selected="true">
      <span class="module-tab-icon"><%= icon("users") %></span>
      <span class="module-tab-copy">
        <strong>General</strong>
        <small>Identidad y contacto</small>
      </span>
    </button>
    <button type="button" class="module-tab" data-tabs-target="tab" data-tab-id="fel" data-action="tabs#switch" role="tab" aria-selected="false">
      <span class="module-tab-icon"><%= icon("shield") %></span>
      <span class="module-tab-copy">
        <strong>FEL / INFILE</strong>
        <small>Certificación y fiscal</small>
      </span>
    </button>
    <button type="button" class="module-tab module-tab-emphasis" data-tabs-target="tab" data-tab-id="cotizacion" data-action="tabs#switch" role="tab" aria-selected="false">
      <span class="module-tab-icon"><%= icon("report") %></span>
      <span class="module-tab-copy">
        <strong>Cotización</strong>
        <small>Branding y contacto</small>
      </span>
    </button>
    <button type="button" class="module-tab" data-tabs-target="tab" data-tab-id="documento" data-action="tabs#switch" role="tab" aria-selected="false">
      <span class="module-tab-icon"><%= icon("contract") %></span>
      <span class="module-tab-copy">
        <strong>Documento</strong>
        <small>Texto, términos y firma</small>
      </span>
    </button>
  </div>

  <section class="panel module-tab-panel is-active" data-tabs-target="panel" data-tab-id="general">
    <div class="panel-header">
      <div>
        <h2>Información General</h2>
        <p>Datos base para la administración operativa y comercial de la empresa.</p>
      </div>
    </div>

    <div class="detail-grid">
      <div class="detail-item"><span>Nombre Comercial</span><strong><%= company.commercial_name.presence || "-" %></strong></div>
      <div class="detail-item"><span>Razón Social</span><strong><%= company.legal_name.presence || "-" %></strong></div>
      <div class="detail-item"><span>NIT</span><strong><%= company.tax_id.presence || "-" %></strong></div>
      <div class="detail-item"><span>Tipo de Empresa</span><strong><%= company.company_type.presence || "-" %></strong></div>
      <div class="detail-item"><span>Correo Electrónico</span><strong><%= company.email.presence || "-" %></strong></div>
      <div class="detail-item"><span>Correo Comercial</span><strong><%= company.correo_comercial.presence || "-" %></strong></div>
      <div class="detail-item"><span>Teléfono</span><strong><%= company.phone.presence || "-" %></strong></div>
      <div class="detail-item"><span>Web Corporativa</span><strong><%= company.web.presence || "-" %></strong></div>
      <div class="detail-item">
        <span>Color Primario</span>
        <strong style="color:<%= company.branding_primary_color_display %>;"><%= company.branding_primary_color_display %></strong>
      </div>
      <div class="detail-item">
        <span>Color Secundario</span>
        <strong style="color:<%= company.branding_secondary_color_display %>;"><%= company.branding_secondary_color_display %></strong>
      </div>
      <div class="detail-item">
        <span>Color de Acento</span>
        <strong style="color:<%= company.branding_accent_color_display %>;"><%= company.branding_accent_color_display %></strong>
      </div>
      <div class="detail-item detail-item-full"><span>Dirección</span><strong><%= company.address.presence || "-" %></strong></div>
      <div class="detail-item"><span>Estado</span><strong><%= company.status.presence || "-" %></strong></div>
      <div class="detail-item"><span>Activa</span><strong><%= company.active? ? "Sí" : "No" %></strong></div>
    </div>

    <% if company.logo.attached? %>
      <div class="branding-preview-card">
        <%= image_tag company.logo, class: "branding-preview-image", alt: "Logo corporativo" %>
      </div>
    <% end %>
  </section>

  <section class="panel module-tab-panel" data-tabs-target="panel" data-tab-id="fel" hidden>
    <div class="panel-header">
      <div>
        <h2>Configuración FEL / INFILE</h2>
        <p>Parámetros internos de certificación y datos fiscales de la empresa.</p>
      </div>
      <%= render "shared/badge", text: "Interno", tone: "warning" %>
    </div>

    <div class="detail-grid">
      <div class="detail-item"><span>Prefijo INFILE</span><strong><%= company.infile_prefix.presence || "-" %></strong></div>
      <div class="detail-item"><span>Llave INFILE</span><strong><%= company.infile_key.presence || "-" %></strong></div>
      <div class="detail-item"><span>Prefijo Firma</span><strong><%= company.infile_signature_prefix.presence || "-" %></strong></div>
      <div class="detail-item"><span>Llave Firma</span><strong><%= company.infile_signature_key.presence || "-" %></strong></div>
      <div class="detail-item"><span>Afiliación IVA</span><strong><%= company.vat_affiliation.presence || "-" %></strong></div>
      <div class="detail-item"><span>Token FEL</span><strong><%= company.fel_token.presence || "-" %></strong></div>
      <div class="detail-item"><span>Código Escenario</span><strong><%= company.fel_scenario_code.presence || "-" %></strong></div>
      <div class="detail-item"><span>Correo de Notificaciones</span><strong><%= company.notification_email.presence || "-" %></strong></div>
    </div>
  </section>

  <section class="panel module-tab-panel" data-tabs-target="panel" data-tab-id="cotizacion" hidden>
    <div class="panel-header">
      <div>
        <h2>Branding y Contacto Comercial</h2>
        <p>Datos de identidad comercial que se imprimen en la cotización emitida por esta empresa.</p>
      </div>
      <%= render "shared/badge", text: "Cotización", tone: "info" %>
    </div>

    <% if company.quote_logo.attached? %>
      <div class="branding-preview-card">
        <%= image_tag company.quote_logo, class: "branding-preview-image", alt: "Logo de cotización" %>
      </div>
    <% end %>

    <div class="detail-grid">
      <div class="detail-item"><span>Formato de Cotización</span><strong><%= company.quote_format_name.presence || "-" %></strong></div>
      <div class="detail-item"><span>URL de Contacto</span><strong><%= company.quote_website_url.presence || "-" %></strong></div>
      <div class="detail-item"><span>Nombre de Contacto</span><strong><%= company.quote_contact_name.presence || "-" %></strong></div>
      <div class="detail-item"><span>Cargo o Área</span><strong><%= company.quote_contact_role.presence || "-" %></strong></div>
      <div class="detail-item"><span>Correo de Contacto</span><strong><%= company.quote_contact_email.presence || "-" %></strong></div>
      <div class="detail-item"><span>Teléfono de Contacto</span><strong><%= company.quote_contact_phone.presence || "-" %></strong></div>
      <div class="detail-item">
        <span>Color de Encabezados de Tabla</span>
        <strong>
          <span style="display:inline-flex;width:18px;height:18px;border-radius:999px;background:<%= company.quote_table_header_color_display %>;border:1px solid rgba(15,23,42,.12);vertical-align:middle;margin-right:8px;"></span>
          <%= company.quote_table_header_color_display %>
        </strong>
      </div>
      <div class="detail-item">
        <span>Color de Datos de Contacto</span>
        <strong style="color:<%= company.quote_contact_text_color_display %>;"><%= company.quote_contact_text_color_display %></strong>
      </div>
      <div class="detail-item detail-item-full"><span>Texto Inferior del PDF</span><strong><%= company.quote_footer_note.presence || "-" %></strong></div>
    </div>
  </section>

  <section class="panel module-tab-panel" data-tabs-target="panel" data-tab-id="documento" hidden>
    <div class="panel-header">
      <div>
        <h2>Plantilla del Documento Comercial</h2>
        <p>Textos de portada, carta, términos y firma usados al generar el PDF de la empresa.</p>
      </div>
    </div>

    <div class="detail-grid">
      <div class="detail-item"><span>Título Visible del PDF</span><strong><%= company.quote_title.presence || "-" %></strong></div>
      <div class="detail-item"><span>Subtítulo del PDF</span><strong><%= company.quote_subtitle.presence || "-" %></strong></div>
      <div class="detail-item"><span>Nombre de Firma</span><strong><%= company.quote_signature_name.presence || company.quote_contact_name.presence || "-" %></strong></div>
      <div class="detail-item"><span>Cargo de Firma</span><strong><%= company.quote_signature_role.presence || company.quote_contact_role.presence || "-" %></strong></div>
      <div class="detail-item detail-item-full"><span>Texto de Bienvenida</span><strong><%= company.quote_intro_text.presence || "-" %></strong></div>
      <div class="detail-item detail-item-full"><span>Términos Comerciales</span><strong><%= company.quote_terms_text.presence || "-" %></strong></div>
      <div class="detail-item detail-item-full"><span>Texto de Cierre</span><strong><%= company.quote_closing_text.presence || "-" %></strong></div>
    </div>
  </section>
</section>
