<section class="page-section">
  <div class="page-heading">
    <div>
      <h1><%= @page_title %></h1>
      <% if @page_description.present? %>
        <p><%= @page_description %></p>
      <% end %>
    </div>
    <%= link_to "Nueva empresa", new_company_path, class: "ui-button ui-button-primary" %>
  </div>

  <div class="panel filters-panel">
    <%= form_with url: companies_path, method: :get, class: "filters-form" do %>
      <div class="filters-bar">
        <label class="search-shell inline-search-shell">
          <span class="search-icon"><%= icon("search") %></span>
          <%= text_field_tag :query, @filters[:query], placeholder: "Buscar por nombre, NIT o correo" %>
        </label>
        <div class="filter-chip-list filter-select-list">
          <%= hidden_field_tag :per_page, @companies_per_page %>
          <%= select_tag :status,
                         options_for_select([["Todos los estados", ""], ["Activas", "active"], ["Inactivas", "inactive"], ["Borrador", "draft"]], @filters[:status]),
                         class: "filter-select" %>
          <%= select_tag :certification,
                         options_for_select([["Toda la certificación", ""], ["Con FEL configurado", "configured"], ["Configuración pendiente", "pending"]], @filters[:certification]),
                         class: "filter-select" %>
          <%= submit_tag "Aplicar filtros", class: "ui-button ui-button-primary submit-button" %>
          <%= link_to "Limpiar", companies_path, class: "ui-button ui-button-secondary" %>
        </div>
      </div>
    <% end %>
  </div>

  <div class="panel">
    <div class="panel-header">
      <div>
        <h2>Listado de empresas</h2>
      </div>
      <%= render "shared/badge", text: "#{@companies_total_count} registros", tone: "info" %>
    </div>

    <% if @companies.any? %>
      <div class="table-shell">
        <table class="data-table">
          <thead>
            <tr>
              <th>Nombre Comercial</th>
              <th>Razón Social</th>
              <th>NIT</th>
              <th>Estado</th>
              <th>Correo Notificaciones</th>
              <th>Código Escenario</th>
              <th>Acciones</th>
            </tr>
          </thead>
          <tbody>
            <% @companies.each do |company| %>
              <tr>
                <td><%= company.commercial_name %></td>
                <td><%= company.legal_name %></td>
                <td><%= company.tax_id %></td>
                <td><%= render "shared/badge", text: company.status.presence || (company.active? ? "Activa" : "Inactiva"), tone: company.active? ? "success" : "warning" %></td>
                <td><%= company.notification_email.presence || "Sin configurar" %></td>
                <td><%= company.fel_scenario_code.presence || "Sin definir" %></td>
                <td class="table-actions">
                  <%= table_action_link "Ver", company_path(company), action: :view %>
                  <%= table_action_link "Editar", edit_company_path(company), action: :edit %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>

      <div class="table-pagination">
        <div class="pagination-controls">
          <%= form_with url: companies_path, method: :get, class: "pagination-size-form" do %>
            <%= hidden_field_tag :query, @filters[:query] if @filters[:query].present? %>
            <%= hidden_field_tag :status, @filters[:status] if @filters[:status].present? %>
            <%= hidden_field_tag :certification, @filters[:certification] if @filters[:certification].present? %>
            <label for="companies_per_page">Resultados</label>
            <%= select_tag :per_page,
                           options_for_select([[10, 10], [20, 20], [50, 50], [100, 100]], @companies_per_page),
                           id: "companies_per_page",
                           class: "filter-select pagination-size-select",
                           onchange: "this.form.submit()" %>
          <% end %>

          <nav class="pagination-nav" aria-label="Paginación de empresas">
            <% pagination_params = request.query_parameters.except("page").merge(per_page: @companies_per_page) %>
            <%= link_to "Anterior",
                        companies_path(pagination_params.merge(page: @companies_page - 1)),
                        class: "ui-button ui-button-secondary pagination-button #{'is-disabled' if @companies_page <= 1}",
                        aria: { disabled: @companies_page <= 1 } %>

            <span class="pagination-current">Página <%= @companies_page %> de <%= @companies_total_pages %></span>

            <%= link_to "Siguiente",
                        companies_path(pagination_params.merge(page: @companies_page + 1)),
                        class: "ui-button ui-button-secondary pagination-button #{'is-disabled' if @companies_page >= @companies_total_pages}",
                        aria: { disabled: @companies_page >= @companies_total_pages } %>
          </nav>
        </div>
      </div>
    <% else %>
      <%= render "shared/empty_state",
                 title: "No hay empresas registradas",
                 description: "Crea la primera empresa para comenzar a cargar su configuración general y FEL / INFILE." %>
    <% end %>
  </div>
</section>
