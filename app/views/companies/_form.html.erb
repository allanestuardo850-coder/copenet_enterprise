<%= form_with(model: company,
              class: "company-form",
              html: { multipart: true },
              data: {
                controller: "tabs company-inactivation",
                tabs_default_value: "general",
                company_inactivation_original_inactive_value: company.inactive
              }) do |form| %>
  <% if company.errors.any? %>
    <section class="panel form-errors">
      <div class="panel-header">
        <div>
          <h2>Corrige los siguientes campos</h2>
          <p>La empresa no pudo guardarse todavía.</p>
        </div>
      </div>
      <ul class="error-list">
        <% company.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </section>
  <% end %>

  <%= render "form_tabs", form: form, company: company %>

  <% if company.persisted? %>
    <div class="confirm-modal-backdrop" data-company-inactivation-target="modal" hidden>
      <div class="confirm-modal" role="dialog" aria-modal="true" aria-labelledby="company-inactivation-title">
        <div class="confirm-modal-icon"><%= icon("alert") %></div>
        <div class="confirm-modal-copy">
          <h2 id="company-inactivation-title">Confirmar inhabilitación</h2>
          <p>Al inhabilitar esta compañía, sus productos y servicios asociados quedarán inactivos y la compañía ya no tendrá acceso operativo.</p>
        </div>
        <div class="confirm-modal-actions">
          <button type="button" class="ui-button ui-button-secondary" data-action="company-inactivation#cancel">Cancelar</button>
          <button type="button" class="ui-button ui-button-primary" data-action="company-inactivation#confirm">Confirmar y guardar</button>
        </div>
      </div>
    </div>
  <% end %>
<% end %>
