<section class="page-section user-admin-page">
  <section class="panel user-profile-strip company-config-strip">
    <div class="user-profile-strip-main">
      <div class="user-profile-avatar"><%= (@company.commercial_name.presence || @company.legal_name).to_s.first(2).upcase %></div>
      <div class="user-profile-copy">
        <strong><%= @company.commercial_name.presence || @company.legal_name %></strong>
        <span>Configuración operativa, fiscal y comercial</span>
        <div class="user-profile-badges">
          <%= render "shared/badge", text: @company.active? ? "Activa" : "Inactiva", tone: @company.active? ? "success" : "warning" %>
          <%= render "shared/badge", text: "Configuración", tone: "info" %>
        </div>
      </div>
    </div>
    <div class="user-profile-actions">
      <%= link_to "Volver", companies_path, class: "ui-button ui-button-secondary" %>
      <%= link_to "Detalle", company_path(@company), class: "ui-button ui-button-secondary" %>
      <%= link_to "Editar", edit_company_path(@company), class: "ui-button ui-button-primary" %>
    </div>
  </section>

  <%= render "detail_tabs", company: @company, default_tab: "cotizacion" %>
</section>
