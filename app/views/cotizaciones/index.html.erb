<section class="page-section user-module-page user-index-page cotizaciones-index-page">
  <section class="panel filters-panel user-index-panel user-index-filters-panel">
    <%= form_with url: cotizaciones_path, method: :get, class: "filters-form" do %>
      <div class="filters-bar">
        <label class="search-shell inline-search-shell">
          <span class="search-icon"><%= icon("search") %></span>
          <%= text_field_tag :query, @filtros[:query], placeholder: "Buscar por código, cliente, contacto o correo" %>
        </label>
        <div class="filter-chip-list filter-select-list">
          <%= select_tag :estado,
                         options_for_select([["Todos los estados", ""]] + Cotizacion::ESTADOS.map { |estado| [estado, estado] }, @filtros[:estado]),
                         class: "filter-select" %>
          <%= submit_tag "Aplicar filtros", class: "ui-button ui-button-primary submit-button" %>
          <%= link_to "Limpiar", cotizaciones_path, class: "ui-button ui-button-secondary" %>
        </div>
      </div>
    <% end %>
  </section>

  <section class="panel user-index-panel user-index-table-panel">
    <div class="panel-header">
      <h2>Listado de cotizaciones</h2>
      <div class="page-actions-inline">
        <%= link_to "Nueva desde productos", productos_servicios_path, class: "ui-button ui-button-primary" %>
      </div>
    </div>

    <% if @cotizaciones.any? %>
      <div class="table-shell user-index-table-shell">
        <table class="data-table cotizaciones-table">
          <thead>
            <tr>
              <th>Código</th>
              <th>Producto o Servicio</th>
              <th>Cliente</th>
              <th>Tipo cliente</th>
              <th>Contacto</th>
              <th>Fecha</th>
              <th>Estado</th>
              <th>Vigencia</th>
              <th>Totales por Moneda</th>
              <th>No cobrado CopeNET</th>
              <th>Acciones</th>
            </tr>
          </thead>
          <tbody>
            <% @cotizaciones.each do |cotizacion| %>
              <tr>
                <td class="roles-users-count"><%= cotizacion.codigo %></td>
                <td class="user-index-name">
                  <div><%= cotizacion.producto_servicio&.nombre || "-" %></div>
                  <% if cotizacion.producto_servicio&.codigo.present? %>
                    <small><%= cotizacion.producto_servicio.codigo %></small>
                  <% end %>
                </td>
                <td><%= cotizacion[:cliente] %></td>
                <td><span class="user-index-chip user-index-chip-primary"><%= cotizacion.cliente_registro&.client_type&.humanize || "-" %></span></td>
                <td>
                  <div><%= cotizacion.contacto %></div>
                  <% if cotizacion.correo.present? %>
                    <small><%= cotizacion.correo %></small>
                  <% end %>
                </td>
                <td><%= l(cotizacion.created_at.to_date, format: :long) %></td>
                <td>
                  <span class="user-index-chip user-index-chip-level"><%= cotizacion.estado.humanize %></span>
                  <% unless cotizacion.firmada? %>
                    <%= form_with url: actualizar_estado_cotizacion_path(cotizacion), method: :patch, class: "inline-form" do %>
                      <%= select_tag "cotizacion[estado]",
                                     options_for_select(Cotizacion::ESTADOS.map { |estado| [estado.humanize, estado] }, cotizacion.estado),
                                     class: "filter-select" %>
                      <%= submit_tag "Cambiar", class: "table-link button-link" %>
                    <% end %>
                  <% end %>
                </td>
                <td><%= "#{cotizacion.vigencia_dias} días" %></td>
                <td><%= resumen_totales_por_moneda(cotizacion.cotizacion_detalles, atributo: :applied_price, producto_servicio: cotizacion.producto_servicio) %></td>
                <td><%= number_to_currency(cotizacion.total_no_cobrado_copenet, unit: "#{moneda_simbolo_producto(cotizacion.producto_servicio)} ") %></td>
                <td class="table-actions">
                  <%= table_action_link "Ver", cotizacion_productos_servicio_path(cotizacion.producto_servicio, cotizacion_id: cotizacion.id), action: :view %>
                  <% unless cotizacion.firmada? %>
                    <%= table_action_link "Editar", cotizacion_productos_servicio_path(cotizacion.producto_servicio, cotizacion_id: cotizacion.id, modo: "editar"), action: :edit %>
                  <% end %>
                  <%= link_to icon("download"), cotizacion_pdf_productos_servicio_path(cotizacion.producto_servicio, cotizacion_id: cotizacion.id), class: "table-link table-action-icon table-action-configure", title: "Descargar PDF", aria: { label: "Descargar PDF" } %>
                  <%= link_to icon("box"), productos_servicio_path(cotizacion.producto_servicio), class: "table-link table-action-icon table-action-configure", title: "Ver producto", aria: { label: "Ver producto" } %>
                  <% unless cotizacion.firmada? %>
                    <%= button_to "Firmar", actualizar_estado_cotizacion_path(cotizacion, cotizacion: { estado: "firmada", signed_by: current_usuario&.nombre_completo }), method: :patch, class: "table-link button-link", form_class: "inline-form" %>
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <%= render "shared/empty_state",
                 title: "No hay cotizaciones generadas",
                 description: "Cuando generes cotizaciones desde productos y servicios aparecerán aquí para su seguimiento central." %>
    <% end %>
  </section>
</section>
