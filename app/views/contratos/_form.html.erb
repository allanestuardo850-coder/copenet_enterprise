<%= form_with model: contrato, class: "company-form" do |form| %>
  <% if contrato.errors.any? %>
    <section class="panel form-errors">
      <ul class="error-list">
        <% contrato.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </section>
  <% end %>

  <section class="panel product-tabs-panel">
    <div class="panel-header">
      <div><h2>Configuración del contrato</h2></div>
      <div class="form-actions company-form-header-actions">
        <%= form.submit "Guardar", class: "ui-button ui-button-primary submit-button" %>
        <%= link_to "Cancelar", contratos_path, class: "ui-button ui-button-secondary" %>
      </div>
    </div>
  </section>

  <section class="panel form-section">
    <div class="panel-header"><div><h2>Información general</h2></div></div>
    <div class="form-grid">
      <div class="field-group">
        <%= form.label :codigo, "Código" %>
        <%= form.text_field :codigo, class: "text-input" %>
      </div>
      <div class="field-group">
        <%= form.label :cliente_id, "Cliente registrado" %>
        <%= form.select :cliente_id, options_from_collection_for_select(@clientes, :id, :nombre, contrato.cliente_id), { include_blank: "Seleccionar cliente" }, class: "text-input filter-select" %>
      </div>
      <div class="field-group">
        <%= form.label :cliente_nombre, "Nombre del cliente" %>
        <%= form.text_field :cliente_nombre, class: "text-input" %>
      </div>
      <div class="field-group">
        <%= form.label :tipo_contrato, "Tipo de contrato" %>
        <%= form.select :tipo_contrato, options_for_select(Contrato::TIPOS, contrato.tipo_contrato), { include_blank: "Seleccionar tipo" }, class: "text-input filter-select" %>
      </div>
      <div class="field-group">
        <%= form.label :fecha_inicio, "Fecha de inicio" %>
        <%= form.date_field :fecha_inicio, class: "text-input" %>
      </div>
      <div class="field-group">
        <%= form.label :fecha_fin, "Fecha de fin" %>
        <%= form.date_field :fecha_fin, class: "text-input" %>
      </div>
      <div class="field-group">
        <%= form.label :valor, "Valor" %>
        <%= form.number_field :valor, class: "text-input", min: 0, step: "0.01" %>
      </div>
      <div class="field-group">
        <%= form.label :moneda_id, "Moneda" %>
        <%= form.select :moneda_id, options_from_collection_for_select(@monedas, :id, :nombre, contrato.moneda_id), { include_blank: "Seleccionar moneda" }, class: "text-input filter-select" %>
      </div>
      <div class="field-group">
        <%= form.label :estado, "Estado" %>
        <%= form.select :estado, options_for_select(Contrato::ESTADOS.map { |estado| [estado.humanize, estado] }, contrato.estado), {}, class: "text-input filter-select" %>
      </div>
      <div class="field-group">
        <%= form.label :responsable, "Responsable" %>
        <%= form.text_field :responsable, class: "text-input" %>
      </div>
      <% if contrato.persisted? %>
        <div class="field-group checkbox-group">
          <label class="checkbox-label">
            <%= hidden_field_tag "contrato[activo]", "1" %>
            <%= check_box_tag "contrato[activo]", "0", !contrato.activo? %>
            <span>Inactivar</span>
          </label>
        </div>
      <% else %>
        <%= form.hidden_field :activo, value: true %>
      <% end %>
      <div class="field-group field-group-full">
        <%= form.label :notas, "Notas" %>
        <%= form.text_area :notas, rows: 4, class: "text-input text-area" %>
      </div>
    </div>
  </section>
<% end %>
