<section class="page-section user-module-page user-index-page contratos-index-page">
  <section class="panel filters-panel user-index-panel user-index-filters-panel">
    <%= form_with url: contratos_path, method: :get, class: "filters-form" do %>
      <div class="filters-bar">
        <label class="search-shell inline-search-shell">
          <span class="search-icon"><%= icon("search") %></span>
          <%= text_field_tag :query, @filters[:query], placeholder: "Buscar por código, cliente, tipo o responsable" %>
        </label>
        <div class="filter-chip-list filter-select-list">
          <%= hidden_field_tag :per_page, @contratos_per_page %>
          <%= select_tag :status,
                         options_for_select([["Todos los estados", ""]] + Contrato::ESTADOS.map { |estado| [estado.humanize, estado] }, @filters[:status]),
                         class: "filter-select" %>
          <%= submit_tag "Aplicar filtros", class: "ui-button ui-button-primary submit-button" %>
          <%= link_to "Limpiar", contratos_path, class: "ui-button ui-button-secondary" %>
        </div>
      </div>
    <% end %>
  </section>

  <section class="panel user-index-panel user-index-table-panel">
    <div class="panel-header">
      <h2>Listado de contratos</h2>
      <div class="page-actions-inline">
        <%= link_to "Nuevo contrato", new_contrato_path, class: "ui-button ui-button-primary" %>
      </div>
    </div>

    <% if @contratos.any? %>
      <div class="table-shell user-index-table-shell">
        <table class="data-table contratos-table">
          <thead>
            <tr>
              <th>Código</th>
              <th>Cliente</th>
              <th>Tipo</th>
              <th>Vigencia</th>
              <th>Valor</th>
              <th>Estado</th>
              <th>Acciones</th>
            </tr>
          </thead>
          <tbody>
            <% @contratos.each do |contrato| %>
              <tr>
                <td class="user-index-name"><%= contrato.codigo %></td>
                <td class="user-index-email"><%= contrato.cliente_nombre %></td>
                <td><span class="user-index-chip user-index-chip-primary"><%= contrato.tipo_contrato.presence || "Sin tipo" %></span></td>
                <td><%= [contrato.fecha_inicio, contrato.fecha_fin].compact.join(" - ").presence || "-" %></td>
                <td class="roles-users-count"><%= contrato.valor_formateado %></td>
                <td><span class="user-index-chip <%= contrato.activo? ? "user-index-chip-success" : "user-index-chip-warning" %>"><%= contrato.activo? ? contrato.estado.humanize : "Inactivo" %></span></td>
                <td class="table-actions">
                  <%= table_action_link "Ver", contrato_path(contrato), action: :view %>
                  <%= table_action_link "Editar", edit_contrato_path(contrato), action: :edit %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>

      <div class="table-pagination">
        <div class="pagination-controls">
          <%= form_with url: contratos_path, method: :get, class: "pagination-size-form" do %>
            <%= hidden_field_tag :query, @filters[:query] if @filters[:query].present? %>
            <%= hidden_field_tag :status, @filters[:status] if @filters[:status].present? %>
            <label for="contratos_per_page">Resultados</label>
            <%= select_tag :per_page,
                           options_for_select([[10, 10], [20, 20], [50, 50], [100, 100]], @contratos_per_page),
                           id: "contratos_per_page",
                           class: "filter-select pagination-size-select",
                           onchange: "this.form.submit()" %>
          <% end %>

          <nav class="pagination-nav" aria-label="Paginación de contratos">
            <% pagination_params = request.query_parameters.except("page").merge(per_page: @contratos_per_page) %>
            <%= link_to "Anterior", contratos_path(pagination_params.merge(page: @contratos_page - 1)), class: "ui-button ui-button-secondary pagination-button #{'is-disabled' if @contratos_page <= 1}", aria: { disabled: @contratos_page <= 1 } %>
            <span class="pagination-current">Página <%= @contratos_page %> de <%= @contratos_total_pages %></span>
            <%= link_to "Siguiente", contratos_path(pagination_params.merge(page: @contratos_page + 1)), class: "ui-button ui-button-secondary pagination-button #{'is-disabled' if @contratos_page >= @contratos_total_pages}", aria: { disabled: @contratos_page >= @contratos_total_pages } %>
          </nav>
        </div>
      </div>
    <% else %>
      <%= render "shared/empty_state",
                 title: @filters.values.any?(&:present?) ? "No se encontraron contratos" : "No hay contratos registrados",
                 description: @filters.values.any?(&:present?) ? "Ajusta la búsqueda o limpia los filtros para ver más resultados." : "Registra contratos para controlar vigencias, renovaciones y responsables." %>
    <% end %>
  </section>
</section>
