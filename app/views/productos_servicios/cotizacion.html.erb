<section class="page-section quote-wizard-page">
  <section class="panel product-tabs-panel">
    <div class="panel-header">
      <div>
        <h2>
          <%= if @mostrar_formulario_cotizacion
                @cotizacion.persisted? ? "Editar cotización" : "Generar cotización"
              else
                "Ver cotización"
              end %>
        </h2>
      </div>

      <div class="form-actions company-form-header-actions">
        <% if @cotizacion_seleccionada&.persisted? %>
          <%= link_to "PDF", cotizacion_pdf_productos_servicio_path(@producto_servicio, cotizacion_id: @cotizacion_seleccionada.id), class: "ui-button ui-button-primary" %>
          <% unless @cotizacion_seleccionada.firmada? %>
            <%= link_to "Editar", cotizacion_productos_servicio_path(@producto_servicio, cotizacion_id: @cotizacion_seleccionada.id, modo: "editar"), class: "ui-button ui-button-secondary" %>
          <% end %>
          <% if @cotizacion_seleccionada.cliente_registro.present? %>
            <%= link_to "Expediente", expediente_cliente_path(@cotizacion_seleccionada.cliente_registro), class: "ui-button ui-button-secondary" %>
          <% end %>
        <% end %>
        <%= link_to "Nueva", cotizacion_productos_servicio_path(@producto_servicio, modo: "nueva"), class: "ui-button ui-button-secondary" %>
        <%= link_to "Producto", productos_servicio_path(@producto_servicio), class: "ui-button ui-button-secondary" %>
        <%= link_to "Volver", productos_servicios_path, class: "ui-button ui-button-secondary" %>
      </div>
    </div>
  </section>

  <div class="cotizacion-status-actions">
    <% if @cotizacion_seleccionada&.persisted? && !@cotizacion_seleccionada.firmada? %>
      <%= button_to "Marcar enviada", actualizar_estado_cotizacion_path(@cotizacion_seleccionada, cotizacion: { estado: "enviada" }), method: :patch, class: "ui-button ui-button-secondary", form_class: "inline-form" %>
      <%= button_to "Aprobar", actualizar_estado_cotizacion_path(@cotizacion_seleccionada, cotizacion: { estado: "aprobada" }), method: :patch, class: "ui-button ui-button-secondary", form_class: "inline-form" %>
      <%= button_to "Firmar", actualizar_estado_cotizacion_path(@cotizacion_seleccionada, cotizacion: { estado: "firmada", signed_by: current_usuario&.nombre_completo }), method: :patch, class: "ui-button ui-button-primary", form_class: "inline-form" %>
    <% end %>
  </div>

  <%# titulo conservado solo como contexto accesible para lectores de pantalla %>
  <span class="visually-hidden">
        <%= if @mostrar_formulario_cotizacion
              @cotizacion.persisted? ? "Editar Cotización" : "Generar Cotización"
            else
              "Ver Cotización"
            end %>
  </span>

  <div class="quote-builder-grid quote-wizard-layout">
    <% if @mostrar_formulario_cotizacion %>
      <section class="panel form-section quote-wizard-panel">
        <% if @cotizacion.errors.any? %>
          <section class="panel form-errors">
            <ul class="error-list">
              <% @cotizacion.errors.full_messages.each do |message| %>
                <li><%= message %></li>
              <% end %>
            </ul>
          </section>
        <% end %>

        <%= form_with model: @cotizacion,
                      url: @cotizacion.persisted? ? cotizacion_path(@cotizacion) : cotizacion_productos_servicio_path(@producto_servicio),
                      method: @cotizacion.persisted? ? :patch : :post,
                      class: "company-form",
                      data: {
                        controller: "cotizacion-detalles tabs",
                        tabs_default_value: "cliente",
                        cotizacion_detalles_index_value: @cotizacion.cotizacion_detalles.size
                      } do |form| %>
          <section class="panel product-tabs-panel quote-wizard-tabs-panel">
            <div class="panel-header">
              <div>
                <h2><%= @cotizacion.persisted? ? "Editar cotización #{ @cotizacion.codigo }" : "Nueva cotización" %></h2>
              </div>
              <div class="form-actions company-form-header-actions">
                <%= form.submit @cotizacion.persisted? ? "Guardar" : "Generar", class: "ui-button ui-button-primary submit-button" %>
                <% if @cotizacion.persisted? %>
                  <%= link_to "Cancelar", cotizacion_productos_servicio_path(@producto_servicio, cotizacion_id: @cotizacion.id), class: "ui-button ui-button-secondary" %>
                <% end %>
              </div>
            </div>

            <div class="module-tabs" role="tablist" aria-label="Secciones para generar cotización">
              <button type="button" class="module-tab is-active" data-tabs-target="tab" data-tab-id="cliente" data-action="tabs#switch" role="tab" aria-selected="true">
                <span class="module-tab-icon"><%= icon("users") %></span>
                <span class="module-tab-copy">
                  <strong>Cliente</strong>
                  <small>Datos y contacto</small>
                </span>
              </button>
              <button type="button" class="module-tab" data-tabs-target="tab" data-tab-id="condiciones" data-action="tabs#switch" role="tab" aria-selected="false">
                <span class="module-tab-icon"><%= icon("coins") %></span>
                <span class="module-tab-copy">
                  <strong>Condiciones</strong>
                  <small>Moneda, vigencia y descuento</small>
                </span>
              </button>
              <button type="button" class="module-tab module-tab-emphasis" data-tabs-target="tab" data-tab-id="items" data-action="tabs#switch" role="tab" aria-selected="false">
                <span class="module-tab-icon"><%= icon("receipt") %></span>
                <span class="module-tab-copy">
                  <strong>Ítems</strong>
                  <small>Conceptos de la propuesta</small>
                </span>
              </button>
              <button type="button" class="module-tab" data-tabs-target="tab" data-tab-id="notas" data-action="tabs#switch" role="tab" aria-selected="false">
                <span class="module-tab-icon"><%= icon("message") %></span>
                <span class="module-tab-copy">
                  <strong>Notas</strong>
                  <small>Alcance y observaciones</small>
                </span>
              </button>
              <button type="button" class="module-tab" data-tabs-target="tab" data-tab-id="resumen" data-action="tabs#switch" role="tab" aria-selected="false">
                <span class="module-tab-icon"><%= icon("report") %></span>
                <span class="module-tab-copy">
                  <strong>Resumen económico</strong>
                  <small>Revisión final</small>
                </span>
              </button>
            </div>
          </section>

          <div class="company-general-wizard quote-wizard-grid">
            <section class="panel form-section module-tab-panel company-wizard-card company-wizard-card-full quote-wizard-step is-active" data-tabs-target="panel" data-tab-id="cliente">
              <div class="company-quote-card-header">
                <span class="company-card-icon"><%= icon("users") %></span>
                <div>
                  <h3>Cliente y contacto</h3>
                  <p>Información visible en la cotización y enlace al expediente comercial.</p>
                </div>
              </div>
              <div class="form-grid quote-wizard-card-grid">
                <div class="field-group field-group-full">
                  <%= form.label :cliente_id, "Cliente registrado" %>
                  <%= form.select :cliente_id,
                                  options_for_select(@clientes.map { |cliente| ["#{cliente.nombre} · #{client_type_label(cliente)}", cliente.id] }, @cotizacion.cliente_id),
                                  { include_blank: "Selecciona un cliente" },
                                  class: "text-input filter-select" %>
                  <p class="field-help">Selecciona un cliente real para activar reglas CopeNET, expediente y proyecto automático.</p>
                </div>
                <div class="field-group">
                  <%= form.label :cliente, "Nombre visible en documento" %>
                  <%= form.text_field :cliente, class: "text-input", placeholder: "Nombre del cliente o empresa" %>
                </div>
                <div class="field-group">
                  <%= form.label :contacto, "Contacto comercial" %>
                  <%= form.text_field :contacto, class: "text-input", placeholder: "Nombre del contacto" %>
                </div>
                <div class="field-group">
                  <%= form.label :correo, "Correo electrónico" %>
                  <%= form.email_field :correo, class: "text-input", placeholder: "correo@cliente.com" %>
                </div>
                <div class="field-group">
                  <%= form.label :telefono, "Teléfono" %>
                  <%= form.text_field :telefono, class: "text-input", placeholder: "+502 5555-5555" %>
                </div>
              </div>
            </section>

            <section class="panel form-section module-tab-panel company-wizard-card company-wizard-card-full quote-wizard-step" data-tabs-target="panel" data-tab-id="condiciones" hidden>
              <div class="company-quote-card-header">
                <span class="company-card-icon"><%= icon("coins") %></span>
                <div>
                  <h3>Condiciones comerciales</h3>
                  <p>Vigencia, moneda, estado inicial y descuento negociado.</p>
                </div>
              </div>
              <div class="form-grid quote-wizard-card-grid">
                <div class="field-group">
                  <%= form.label :vigencia_dias, "Vigencia de la oferta" %>
                  <%= form.number_field :vigencia_dias, class: "text-input", min: 1, step: 1 %>
                </div>
                <div class="field-group">
                  <%= form.label :estado, "Estado inicial" %>
                  <%= form.select :estado,
                                  options_for_select(Cotizacion::ESTADOS.map { |estado| [estado.humanize, estado] }, @cotizacion.estado),
                                  {},
                                  class: "text-input filter-select" %>
                </div>
                <div class="field-group">
                  <label>Moneda principal del producto</label>
                  <div class="text-input static-field"><%= "#{moneda_simbolo_producto(@producto_servicio)} · #{moneda_nombre_producto(@producto_servicio)}" %></div>
                </div>
                <div class="field-group">
                  <%= form.label :porcentaje_descuento, "Descuento aplicado %" %>
                  <%= form.number_field :porcentaje_descuento,
                                        class: "text-input",
                                        step: "0.01",
                                        min: 0,
                                        max: 100,
                                        placeholder: "0.00",
                                        data: { action: "input->cotizacion-detalles#updateTotals", cotizacion_detalles_target: "discountInput" } %>
                  <p class="field-help">Si mezclas monedas, el descuento global se desactiva para evitar cálculos incorrectos.</p>
                </div>
                <div class="field-group field-group-full">
                  <%= form.label :precio_base, "Subtotal nominal interno" %>
                  <%= form.number_field :precio_base,
                                        class: "text-input",
                                        step: "0.01",
                                        min: 0,
                                        readonly: true,
                                        data: { cotizacion_detalles_target: "subtotalField" } %>
                </div>
              </div>
            </section>

            <section class="panel form-section module-tab-panel company-wizard-card company-wizard-card-full quote-wizard-step quote-wizard-items-card" data-tabs-target="panel" data-tab-id="items" hidden>
              <div class="company-quote-card-header quote-wizard-items-header">
                <span class="company-card-icon"><%= icon("receipt") %></span>
                <div>
                  <h3>Ítems de la cotización</h3>
                  <p>Agrega conceptos, descripción, precio aplicado, costo interno y recurrencia.</p>
                </div>
                <button type="button" class="ui-button ui-button-primary ui-button-compact" data-action="cotizacion-detalles#add">
                  Agregar ítem
                </button>
              </div>

              <div class="cotizacion-items-summary quote-wizard-totals">
                <article class="mini-metric-card quote-metric-card">
                  <span>Subtotal nominal</span>
                  <strong data-cotizacion-detalles-target="subtotalDisplay"><%= monto_producto(@producto_servicio, @cotizacion.precio_base.presence || 0) %></strong>
                </article>
                <article class="mini-metric-card quote-metric-card">
                  <span>Descuento</span>
                  <strong data-cotizacion-detalles-target="discountDisplay"><%= monto_producto(@producto_servicio, @cotizacion.monto_descuento.presence || 0) %></strong>
                </article>
                <article class="mini-metric-card quote-metric-card">
                  <span>Total final</span>
                  <strong data-cotizacion-detalles-target="finalDisplay"><%= monto_producto(@producto_servicio, @cotizacion.precio_final.presence || @cotizacion.precio_base.presence || 0) %></strong>
                </article>
              </div>

              <div class="currency-summary-panel">
                <strong>Totales por moneda</strong>
                <div class="currency-summary-list" data-cotizacion-detalles-target="currencySummary">
                  <% totales_por_moneda(@cotizacion.cotizacion_detalles.reject(&:marked_for_destruction?), atributo: :applied_price, producto_servicio: @producto_servicio).each do |item| %>
                    <span class="currency-summary-chip"><%= monto_en_moneda(item[:moneda], item[:total]) %></span>
                  <% end %>
                </div>
              </div>

              <div class="cotizacion-items-list" data-cotizacion-detalles-target="list">
                <%= form.fields_for :cotizacion_detalles do |detalle_form| %>
                  <%= render "cotizacion_detalle_fields", form: detalle_form %>
                <% end %>
              </div>

              <template data-cotizacion-detalles-target="template">
                <%= form.fields_for :cotizacion_detalles, CotizacionDetalle.new(moneda_id: @producto_servicio.moneda_id, recurrencia: @producto_servicio.es_recurrente? ? (@producto_servicio.recurrencia.presence || "Mensual") : "Unico", seccion_cotizacion: @producto_servicio.es_recurrente? ? "Cargo mensual" : "Cargo inicial", facturable: @producto_servicio.facturable?, catalog_price: @producto_servicio.precio_base, applied_price: @producto_servicio.precio_base, internal_cost: @producto_servicio.costo_base), child_index: "NEW_RECORD" do |detalle_form| %>
                  <%= render "cotizacion_detalle_fields", form: detalle_form %>
                <% end %>
              </template>
            </section>

            <section class="panel form-section module-tab-panel company-wizard-card company-wizard-card-half quote-wizard-step" data-tabs-target="panel" data-tab-id="notas" hidden>
              <div class="company-quote-card-header">
                <span class="company-card-icon"><%= icon("contract") %></span>
                <div>
                  <h3>Alcance personalizado</h3>
                  <p>Enfoque específico para el cliente y cobertura de la propuesta.</p>
                </div>
              </div>
              <div class="field-group">
                <%= form.label :alcance_personalizado, "Alcance o enfoque personalizado" %>
                <%= form.text_area :alcance_personalizado, rows: 5, class: "text-input text-area", placeholder: "Describe el enfoque específico de la propuesta para este cliente, alcance, cobertura o combinación comercial." %>
              </div>
            </section>

            <section class="panel form-section module-tab-panel company-wizard-card company-wizard-card-half quote-wizard-step" data-tabs-target="panel" data-tab-id="notas" hidden>
              <div class="company-quote-card-header">
                <span class="company-card-icon"><%= icon("message") %></span>
                <div>
                  <h3>Observaciones</h3>
                  <p>Condiciones, exclusiones o notas relevantes para la negociación.</p>
                </div>
              </div>
              <div class="field-group">
                <%= form.label :observaciones, "Observaciones de la cotización" %>
                <%= form.text_area :observaciones, rows: 5, class: "text-input text-area", placeholder: "Agrega observaciones, condiciones comerciales, exclusiones o notas relevantes para esta propuesta." %>
              </div>
            </section>

            <section class="panel form-section module-tab-panel company-wizard-card company-wizard-card-full quote-wizard-summary-panel" data-tabs-target="panel" data-tab-id="resumen" hidden>
              <%= render "cotizacion_resumen_economico" %>
            </section>
          </div>

        <% end %>
      </section>
    <% end %>

    <% unless @mostrar_formulario_cotizacion %>
      <section class="panel quote-highlight-panel">
        <%= render "cotizacion_resumen_economico" %>
      </section>
    <% end %>
  </div>

  <% unless @mostrar_formulario_cotizacion %>
  <section class="panel">
    <div class="panel-header">
      <div>
        <h2>Detalle de Ítems Cotizados</h2>
        <p>Desglose comercial de los conceptos incluidos en la propuesta enviada al cliente.</p>
      </div>
    </div>

    <% if @cotizacion_seleccionada&.cotizacion_detalles&.any? %>
      <div class="table-shell quote-table-shell">
        <table class="data-table quote-table">
          <thead>
            <tr>
              <th>#</th>
              <th>Descripción</th>
              <th>Catálogo</th>
              <th>Aplicado</th>
              <th>Costo interno</th>
              <th>Sección</th>
              <th>Recurrencia</th>
              <th>Regla</th>
            </tr>
          </thead>
          <tbody>
            <% @cotizacion_seleccionada.cotizacion_detalles.each_with_index do |detalle, index| %>
              <tr>
                <td><strong><%= index + 1 %></strong></td>
                <td><%= detalle.descripcion %></td>
                <td class="quote-amount"><%= monto_en_moneda(moneda_para_registro(detalle, @producto_servicio), detalle.catalog_price) %></td>
                <td class="quote-amount"><%= monto_en_moneda(moneda_para_registro(detalle, @producto_servicio), detalle.applied_price) %></td>
                <td class="quote-amount"><%= monto_en_moneda(moneda_para_registro(detalle, @producto_servicio), detalle.internal_cost) %></td>
                <td><%= detalle.seccion_cotizacion.presence || "-" %></td>
                <td><%= detalle.recurrencia.presence || "-" %></td>
                <td><%= detalle.price_rule_applied.presence || "-" %></td>
              </tr>
            <% end %>
            <tr>
              <td colspan="7"><strong>Totales por moneda</strong></td>
              <td class="quote-amount"><strong><%= resumen_totales_por_moneda(@cotizacion_seleccionada.cotizacion_detalles, atributo: :applied_price, producto_servicio: @producto_servicio) %></strong></td>
            </tr>
          </tbody>
        </table>
      </div>
    <% else %>
      <div class="empty-inline-state">
        <strong>No hay ítems detallados en esta cotización.</strong>
        <span>Agrega descripciones y precios para desglosar mejor la propuesta comercial.</span>
      </div>
    <% end %>
  </section>

  <section class="panel">
    <div class="panel-header">
      <div>
        <h2>Base Comercial para la Propuesta</h2>
        <p>Documento guía para que un operador entienda qué presentar, cómo explicarlo y qué validar para avanzar la venta.</p>
      </div>
    </div>

    <div class="document-reading-layout">
      <section class="document-section-card">
        <div class="document-section-header">
          <span class="document-section-step">01</span>
          <div>
            <h3>Qué problema resuelve esta propuesta</h3>
            <p>Ayuda al operador a explicar por qué este producto o servicio es relevante para el cliente.</p>
          </div>
        </div>
        <div class="document-paragraph-card">
          <p><%= @producto_servicio.problema_resuelve.presence || "No se ha documentado todavía el problema principal que resuelve este producto o servicio." %></p>
        </div>
      </section>

      <section class="document-section-card">
        <div class="document-section-header">
          <span class="document-section-step">02</span>
          <div>
            <h3>Cómo se usa o en qué casos aplica</h3>
            <p>Describe escenarios prácticos para que el operador pueda explicarlo con claridad.</p>
          </div>
        </div>
        <div class="document-paragraph-card">
          <p><%= @producto_servicio.caso_uso.presence || "No se ha documentado todavía un caso de uso para este producto o servicio." %></p>
        </div>
      </section>

      <section class="document-section-card">
        <div class="document-section-header">
          <span class="document-section-step">03</span>
          <div>
            <h3>Qué debe incluir la cotización</h3>
            <p>Contenido que debe aparecer en la propuesta para que el cliente entienda el alcance ofrecido.</p>
          </div>
        </div>
        <div class="document-paragraph-card">
          <p><%= @producto_servicio.incluye_cotizacion.presence || "No se ha definido todavía qué debe incluir la cotización de este concepto." %></p>
        </div>
      </section>

      <section class="document-section-card">
        <div class="document-section-header">
          <span class="document-section-step">04</span>
          <div>
            <h3>Qué se necesita para cerrar la venta</h3>
            <p>Checklist comercial para que el operador sepa qué validar antes del cierre.</p>
          </div>
        </div>
        <div class="document-paragraph-card">
          <p><%= @producto_servicio.requisitos_cierre_venta.presence || "No se han documentado todavía los requisitos para cierre de venta." %></p>
        </div>
      </section>

      <% if @cotizacion_seleccionada&.alcance_personalizado.present? %>
        <section class="document-section-card">
          <div class="document-section-header">
            <span class="document-section-step">05</span>
            <div>
              <h3>Alcance personalizado para este cliente</h3>
              <p>Ajuste específico de la propuesta según el caso del prospecto actual.</p>
            </div>
          </div>
          <div class="document-paragraph-card">
            <p><%= @cotizacion_seleccionada.alcance_personalizado %></p>
          </div>
        </section>
      <% end %>
      <% if @cotizacion_seleccionada&.observaciones.present? %>
        <section class="document-section-card">
          <div class="document-section-header">
            <span class="document-section-step">06</span>
            <div>
              <h3>Observaciones adicionales</h3>
              <p>Notas relevantes para presentar o negociar esta propuesta comercial.</p>
            </div>
          </div>
          <div class="document-paragraph-card">
            <p><%= @cotizacion_seleccionada.observaciones %></p>
          </div>
        </section>
      <% end %>
    </div>
  </section>

  <section class="panel">
    <div class="panel-header">
      <div>
        <h2>Estructura de Costos</h2>
        <p>Base interna para revisar rentabilidad y explicar cómo se compone el costo del producto o servicio.</p>
      </div>
    </div>

    <% if @producto_servicio.producto_servicio_costos.any? %>
      <div class="table-shell quote-table-shell">
        <table class="data-table quote-table">
          <thead>
            <tr>
              <th>Tipo</th>
              <th>Nombre</th>
              <th>Recurrencia</th>
              <th>Moneda</th>
              <th>Descripción</th>
              <th>Costo</th>
            </tr>
          </thead>
          <tbody>
            <% @producto_servicio.producto_servicio_costos.each do |costo| %>
              <tr>
                <td><strong><%= costo.tipo_costo %></strong></td>
                <td><%= costo.nombre %></td>
                <td><%= costo.recurrencia %></td>
                <td><%= costo.moneda&.simbolo || @producto_servicio.moneda&.simbolo || "-" %></td>
                <td><%= costo.descripcion.presence || "-" %></td>
                <td class="quote-amount"><%= monto_en_moneda(moneda_para_registro(costo, @producto_servicio), costo.monto) %></td>
              </tr>
            <% end %>
            <tr>
              <td colspan="5"><strong>Totales por moneda</strong></td>
              <td class="quote-amount"><strong><%= resumen_totales_por_moneda(@producto_servicio.producto_servicio_costos, atributo: :monto, producto_servicio: @producto_servicio) %></strong></td>
            </tr>
          </tbody>
        </table>
      </div>
    <% else %>
      <div class="empty-inline-state">
        <strong>No hay costos detallados registrados.</strong>
        <span>La cotización seguirá usando el costo consolidado actual hasta que agregues componentes de costo al catálogo.</span>
      </div>
    <% end %>
  </section>

  <section class="panel">
    <div class="panel-header">
      <div>
        <h2>Listado de Cotizaciones Generadas</h2>
        <p>Historial de propuestas creadas para este producto o servicio.</p>
      </div>
      <%= render "shared/badge", text: "#{@cotizaciones.size} cotizaciones", tone: "info" %>
    </div>

    <% if @cotizaciones.any? %>
      <div class="table-shell">
        <table class="data-table">
          <thead>
            <tr>
              <th>Código</th>
              <th>Cliente</th>
              <th>Contacto</th>
              <th>Totales por moneda</th>
              <th>No cobrado CopeNET</th>
              <th>Descuento</th>
              <th>Estado</th>
              <th>Fecha</th>
              <th>Acciones</th>
            </tr>
          </thead>
          <tbody>
            <% @cotizaciones.each do |cotizacion| %>
              <tr>
                <td><strong><%= cotizacion.codigo %></strong></td>
                <td><%= cotizacion[:cliente] %></td>
                <td><%= cotizacion.contacto %></td>
                <td><%= resumen_totales_por_moneda(cotizacion.cotizacion_detalles, atributo: :applied_price, producto_servicio: @producto_servicio) %></td>
                <td><%= number_to_currency(cotizacion.total_no_cobrado_copenet, unit: "#{moneda_simbolo_producto(@producto_servicio)} ") %></td>
                <td><%= cotizacion.porcentaje_descuento.present? ? "#{number_with_precision(cotizacion.porcentaje_descuento, precision: 2)}%" : "-" %></td>
                <td>
                  <% if cotizacion.firmada? %>
                    <%= cotizacion.estado.humanize %>
                  <% else %>
                    <%= form_with url: actualizar_estado_cotizacion_path(cotizacion), method: :patch, class: "inline-form" do %>
                      <%= select_tag "cotizacion[estado]",
                                     options_for_select(Cotizacion::ESTADOS.map { |estado| [estado.humanize, estado] }, cotizacion.estado),
                                     class: "filter-select" %>
                      <%= submit_tag "Cambiar", class: "table-link button-link" %>
                    <% end %>
                  <% end %>
                </td>
                <td><%= l(cotizacion.created_at, format: :short) rescue cotizacion.created_at.strftime("%d/%m/%Y %H:%M") %></td>
                <td class="table-actions">
                  <%= table_action_link "Ver", cotizacion_productos_servicio_path(@producto_servicio, cotizacion_id: cotizacion.id), action: :view %>
                  <% unless cotizacion.firmada? %>
                    <%= table_action_link "Editar", cotizacion_productos_servicio_path(@producto_servicio, cotizacion_id: cotizacion.id, modo: "editar"), action: :edit %>
                  <% end %>
                  <%= link_to "PDF", cotizacion_pdf_productos_servicio_path(@producto_servicio, cotizacion_id: cotizacion.id), class: "table-link" %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <div class="empty-inline-state">
        <strong>Aún no hay cotizaciones generadas.</strong>
        <span>Completa el formulario superior y guarda la primera cotización para este producto o servicio.</span>
      </div>
    <% end %>
  </section>

  <section class="panel">
    <div class="panel-header">
      <div>
        <h2>Tabla Base de Cotización</h2>
        <p>Resumen económico y operativo que puede convertirse luego en una cotización formal del sistema.</p>
      </div>
    </div>

    <div class="table-shell quote-table-shell">
      <table class="data-table quote-table">
        <thead>
          <tr>
            <th>Concepto</th>
            <th>Detalle</th>
            <th>Valor</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td><strong>Producto / Servicio</strong></td>
            <td>Concepto base de la propuesta.</td>
            <td><%= @producto_servicio.nombre %></td>
          </tr>
          <tr>
            <td><strong>Cliente / Prospecto</strong></td>
            <td>Entidad objetivo de la cotización.</td>
            <td><%= @cotizacion_seleccionada&.[](:cliente).presence || "-" %></td>
          </tr>
          <tr>
            <td><strong>Tipo de cliente</strong></td>
            <td>Clasificación que define reglas CopeNET y comportamiento del expediente.</td>
            <td><%= @cotizacion_seleccionada&.cliente_registro&.client_type&.humanize || "-" %></td>
          </tr>
          <tr>
            <td><strong>Contacto</strong></td>
            <td>Responsable comercial del lado del cliente.</td>
            <td><%= @cotizacion_seleccionada&.contacto.presence || "-" %></td>
          </tr>
          <tr>
            <td><strong>Empresa que factura</strong></td>
            <td>Entidad emisora asociada al producto.</td>
            <td><%= @producto_servicio.company&.commercial_name || @producto_servicio.company&.legal_name || "-" %></td>
          </tr>
          <tr>
            <td><strong>Totales por moneda</strong></td>
            <td>Divisa comercial separada por renglón de la propuesta.</td>
            <td><%= @cotizacion_seleccionada&.present? ? resumen_totales_por_moneda(@cotizacion_seleccionada.cotizacion_detalles, atributo: :precio, producto_servicio: @producto_servicio) : resumen_totales_por_moneda(@cotizacion.cotizacion_detalles, atributo: :precio, producto_servicio: @producto_servicio) %></td>
          </tr>
          <tr>
            <td><strong>Subtotal de ítems</strong></td>
            <td>Suma de todos los conceptos agregados a la cotización.</td>
            <td class="quote-amount"><%= @cotizacion_seleccionada&.persisted? ? monto_producto(@producto_servicio, @cotizacion_seleccionada.precio_base) : monto_producto(@producto_servicio, @producto_servicio.precio_base) %></td>
          </tr>
          <tr>
            <td><strong>Descuento aplicado</strong></td>
            <td>Porcentaje negociado para la cotización.</td>
            <td><%= @cotizacion_seleccionada&.porcentaje_descuento.present? ? "#{number_with_precision(@cotizacion_seleccionada.porcentaje_descuento, precision: 2)}%" : "-" %></td>
          </tr>
          <tr>
            <td><strong>Monto de descuento</strong></td>
            <td>Valor descontado del precio cotizado.</td>
            <td class="quote-amount"><%= @cotizacion_seleccionada&.persisted? ? monto_producto(@producto_servicio, @cotizacion_seleccionada.monto_descuento) : monto_producto(@producto_servicio, 0) %></td>
          </tr>
          <tr>
            <td><strong>Precio final</strong></td>
            <td>Valor final ofrecido al cliente.</td>
            <td class="quote-amount"><%= @cotizacion_seleccionada&.persisted? ? monto_producto(@producto_servicio, @cotizacion_seleccionada.precio_final) : monto_producto(@producto_servicio, @producto_servicio.precio_base) %></td>
          </tr>
          <tr>
            <td><strong>Total no cobrado por regla CopeNET</strong></td>
            <td>Valor entregado sin costo que debe verse en expediente pero no generar cobro.</td>
            <td class="quote-amount"><%= number_to_currency((@cotizacion_seleccionada || @cotizacion).total_no_cobrado_copenet, unit: "#{moneda_simbolo_producto(@producto_servicio)} ") %></td>
          </tr>
          <tr>
            <td><strong>Modelo de cobro</strong></td>
            <td>Forma comercial de monetización.</td>
            <td><%= @producto_servicio.modelo_cobro.presence || "-" %></td>
          </tr>
          <tr>
            <td><strong>Vigencia de la oferta</strong></td>
            <td>Duración estimada de la propuesta enviada.</td>
            <td><%= @cotizacion_seleccionada&.vigencia_dias.present? ? "#{@cotizacion_seleccionada.vigencia_dias} días" : "-" %></td>
          </tr>
        </tbody>
      </table>
    </div>
  </section>

  <section class="panel">
    <div class="panel-header">
      <div>
        <h2>Documentación de Respaldo</h2>
        <p>Archivos que pueden acompañar la propuesta comercial o servir de soporte técnico.</p>
      </div>
    </div>

    <% if @producto_servicio.documentos_comerciales.attached? %>
      <div class="document-list">
        <% @producto_servicio.documentos_comerciales.each do |documento| %>
          <a href="<%= url_for(documento) %>" class="document-item document-item-link" target="_blank" rel="noopener">
            <span class="document-item-icon"><%= icon("report") %></span>
            <div class="document-item-copy">
              <strong><%= documento.filename %></strong>
              <small><%= etiqueta_documento_producto(documento) %></small>
            </div>
          </a>
        <% end %>
      </div>
    <% else %>
      <div class="empty-inline-state">
        <strong>No hay documentos adjuntos.</strong>
        <span>Sube documentación desde la edición del producto para complementar esta base de cotización.</span>
      </div>
    <% end %>
  </section>
  <% end %>
</section>
