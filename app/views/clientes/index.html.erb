<section class="page-section">
  <div class="page-heading">
    <div>
      <p class="eyebrow">Administración</p>
      <h1>Clientes</h1>
      <p>Catálogo de clientes tipificados para aplicar reglas CopeNET, expediente y proyectos.</p>
    </div>
    <%= link_to "Nuevo cliente", new_cliente_path, class: "ui-button ui-button-primary" %>
  </div>

  <div class="panel filters-panel catalog-filters-panel">
    <%= form_with url: clientes_path, method: :get, class: "filters-form" do %>
      <div class="filters-bar">
        <label class="search-shell inline-search-shell">
          <span class="search-icon"><%= icon("search") %></span>
          <%= text_field_tag :query, @filtros[:query], placeholder: "Buscar por nombre, correo o contacto" %>
        </label>
        <div class="filter-chip-list filter-select-list">
          <%= select_tag :client_type,
                         options_for_select([["Todos los tipos", ""]] + Cliente::CLIENT_TYPES.map { |tipo| [tipo.humanize, tipo] }, @filtros[:client_type]),
                         class: "filter-select" %>
          <%= submit_tag "Aplicar filtros", class: "ui-button ui-button-primary submit-button" %>
        </div>
      </div>
    <% end %>
  </div>

  <div class="panel catalog-table-panel">
    <div class="panel-header">
      <div>
        <h2>Listado de clientes</h2>
        <p>Base maestra para cotizaciones, expediente y proyectos.</p>
      </div>
      <%= render "shared/badge", text: "#{@clientes.size} registros", tone: "info" %>
    </div>

    <% if @clientes.any? %>
      <div class="table-shell">
        <table class="data-table">
          <thead>
            <tr>
              <th>Cliente</th>
              <th>Tipo</th>
              <th>CopeNET</th>
              <th>Contacto</th>
              <th>Expediente</th>
              <th>Acciones</th>
            </tr>
          </thead>
          <tbody>
            <% @clientes.each do |cliente| %>
              <tr>
                <td><strong><%= cliente.nombre %></strong></td>
                <td><%= client_type_label(cliente) %></td>
                <td><%= cliente.is_copenet_client? ? "Sí" : "No" %></td>
                <td><%= [cliente.contacto_principal, cliente.email].compact.reject(&:blank?).join(" · ").presence || "-" %></td>
                <td><%= cliente.expediente_cliente.present? ? "Listo" : "Pendiente" %></td>
                <td class="table-actions">
                  <%= table_action_link "Ver", cliente_path(cliente), action: :view %>
                  <%= table_action_link "Expediente", expediente_cliente_path(cliente), action: :expediente %>
                  <%= table_action_link "Editar", edit_cliente_path(cliente), action: :edit %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <%= render "shared/empty_state",
                 title: "No hay clientes registrados",
                 description: "Crea clientes CopeNET y No Socios para activar reglas de precio y expediente." %>
    <% end %>
  </div>
</section>
