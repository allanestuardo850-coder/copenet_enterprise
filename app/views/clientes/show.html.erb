<section class="page-section">
  <div class="page-heading">
    <div>
      <h1><%= @cliente.nombre %></h1>
      <p>Ficha comercial base del cliente para cotizaciones, expediente y proyectos.</p>
    </div>
    <div class="page-actions-inline">
      <%= link_to "Ver expediente", expediente_cliente_path(@cliente), class: "ui-button ui-button-primary" %>
      <%= link_to "Editar", edit_cliente_path(@cliente), class: "ui-button ui-button-secondary" %>
    </div>
  </div>

  <section class="panel user-profile-strip">
    <div class="user-profile-strip-main">
      <div class="user-profile-avatar"><%= @cliente.nombre.to_s.first(2).upcase %></div>
      <div class="user-profile-copy">
        <strong><%= @cliente.nombre %></strong>
        <span><%= @cliente.email.presence || "Sin correo" %></span>
      </div>
    </div>
    <div class="user-profile-metrics">
      <article class="mini-metric-card"><span>Tipo</span><strong><%= client_type_label(@cliente) %></strong></article>
      <article class="mini-metric-card"><span>CopeNET</span><strong><%= @cliente.is_copenet_client? ? "Sí" : "No" %></strong></article>
      <article class="mini-metric-card"><span>Cotizaciones</span><strong><%= @cliente.cotizaciones.count %></strong></article>
    </div>
  </section>

  <section class="panel">
    <div class="panel-header">
      <div>
        <h2>Información general</h2>
        <p>Datos principales para operación comercial.</p>
      </div>
    </div>
    <div class="document-meta-grid">
      <div class="document-meta-item"><span>Contacto principal</span><strong><%= @cliente.contacto_principal.presence || "-" %></strong></div>
      <div class="document-meta-item"><span>Teléfono</span><strong><%= @cliente.telefono.presence || "-" %></strong></div>
      <div class="document-meta-item"><span>Estado</span><strong><%= @cliente.activo? ? "Activo" : "Inactivo" %></strong></div>
      <div class="document-meta-item"><span>Expediente</span><strong><%= @cliente.expediente_cliente.present? ? "Creado" : "Pendiente" %></strong></div>
    </div>
    <% if @cliente.notas.present? %>
      <div class="document-paragraph-card">
        <strong>Notas</strong>
        <p><%= @cliente.notas %></p>
      </div>
    <% end %>
  </section>
</section>
