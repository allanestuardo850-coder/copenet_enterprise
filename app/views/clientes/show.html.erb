<section class="page-section company-show-page">
  <section class="company-show-hero">
    <div class="company-show-identity">
      <div class="company-show-logo">
        <%= @cliente.nombre.to_s.first(2).upcase %>
      </div>

      <div class="company-show-copy">
        <div class="company-show-title-row">
          <strong class="company-show-title"><%= @cliente.nombre %></strong>

          <div class="company-show-badges">
            <%= render "shared/badge", text: @cliente.activo? ? "Activo" : "Inactivo", tone: @cliente.activo? ? "success" : "warning" %>
            <%= render "shared/badge", text: client_type_label(@cliente), tone: @cliente.is_copenet_client? ? "primary" : "info" %>
            <%= render "shared/badge", text: @cliente.expediente_cliente.present? ? "Expediente listo" : "Expediente pendiente", tone: @cliente.expediente_cliente.present? ? "success" : "warning" %>
          </div>
        </div>

        <p><%= @cliente.email.presence || "Sin correo registrado" %></p>
      </div>
    </div>

    <div class="company-show-actions" aria-label="Acciones de cliente">
      <%= link_to "#{icon("chevron")}<span>Volver</span>".html_safe, clientes_path, class: "company-show-action-button company-show-back-button", data: { turbo: false }, title: "Volver al listado", aria: { label: "Volver al listado" } %>
      <%= link_to "#{icon("folder")}<span>Expediente</span>".html_safe, expediente_cliente_path(@cliente), class: "company-show-action-button company-show-action-primary", title: "Ver expediente", aria: { label: "Ver expediente" } %>
      <%= link_to "#{icon("pencil")}<span>Editar</span>".html_safe, edit_cliente_path(@cliente), class: "company-show-action-button company-show-action-primary", title: "Editar cliente", aria: { label: "Editar cliente" } %>
    </div>
  </section>

  <section class="panel cliente-show-details-panel">
    <div class="panel-header">
      <div>
        <h2>Información general</h2>
      </div>
    </div>
    <div class="document-meta-grid cliente-show-meta-grid">
      <div class="document-meta-item"><span>Contacto principal</span><strong><%= @cliente.contacto_principal.presence || "-" %></strong></div>
      <div class="document-meta-item"><span>Teléfono</span><strong><%= @cliente.telefono.presence || "-" %></strong></div>
      <div class="document-meta-item"><span>CopeNET</span><strong><%= @cliente.is_copenet_client? ? "Sí" : "No" %></strong></div>
      <div class="document-meta-item"><span>Cotizaciones</span><strong><%= @cliente.cotizaciones.count %></strong></div>
      <div class="document-meta-item"><span>Estado</span><strong><%= @cliente.activo? ? "Activo" : "Inactivo" %></strong></div>
      <div class="document-meta-item"><span>Expediente</span><strong><%= @cliente.expediente_cliente.present? ? "Creado" : "Pendiente" %></strong></div>
    </div>
    <% if @cliente.notas.present? %>
      <div class="document-paragraph-card">
        <strong>Notas</strong>
        <p><%= @cliente.notas %></p>
      </div>
    <% end %>
  </section>
</section>
