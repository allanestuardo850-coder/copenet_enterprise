<section class="page-section company-show-page">
  <section class="company-show-hero">
    <div class="company-show-identity">
      <div class="company-show-logo">FA</div>
      <div class="company-show-copy">
        <div class="company-show-title-row">
          <strong class="company-show-title"><%= @factura.numero %></strong>
          <div class="company-show-badges">
            <%= render "shared/badge", text: @factura.activo? ? @factura.estado.humanize : "Inactiva", tone: @factura.activo? ? "success" : "warning" %>
          </div>
        </div>
        <p><%= @factura.cliente_nombre %> · <%= @factura.total_formateado %></p>
      </div>
    </div>
    <div class="company-show-actions" aria-label="Acciones de factura">
      <%= link_to "#{icon("chevron")}<span>Volver</span>".html_safe, facturas_path, class: "company-show-action-button company-show-back-button", data: { turbo: false }, title: "Volver al listado", aria: { label: "Volver al listado" } %>
      <%= link_to "#{icon("pencil")}<span>Editar</span>".html_safe, edit_factura_path(@factura), class: "company-show-action-button company-show-action-primary", title: "Editar factura", aria: { label: "Editar factura" } %>
    </div>
  </section>

  <section class="panel detail-section">
    <div class="panel-header"><div><h2>Información de la factura</h2></div></div>
    <div class="detail-grid">
      <div class="detail-item"><span>Serie</span><strong><%= @factura.serie.presence || "-" %></strong></div>
      <div class="detail-item"><span>Cliente</span><strong><%= @factura.cliente_nombre %></strong></div>
      <div class="detail-item"><span>Emisión</span><strong><%= @factura.fecha_emision || "-" %></strong></div>
      <div class="detail-item"><span>Vencimiento</span><strong><%= @factura.fecha_vencimiento || "-" %></strong></div>
      <div class="detail-item"><span>Total</span><strong><%= @factura.total_formateado %></strong></div>
      <div class="detail-item"><span>Moneda</span><strong><%= @factura.moneda&.nombre || "-" %></strong></div>
    </div>
    <% if @factura.notas.present? %>
      <div class="document-paragraph-card">
        <strong>Notas</strong>
        <p><%= @factura.notas %></p>
      </div>
    <% end %>
  </section>
</section>
