<section class="page-section user-module-page user-index-page facturas-index-page">
  <section class="panel filters-panel user-index-panel user-index-filters-panel">
    <%= form_with url: facturas_path, method: :get, class: "filters-form" do %>
      <div class="filters-bar">
        <label class="search-shell inline-search-shell">
          <span class="search-icon"><%= icon("search") %></span>
          <%= text_field_tag :query, @filters[:query], placeholder: "Buscar por número, serie o cliente" %>
        </label>
        <div class="filter-chip-list filter-select-list">
          <%= hidden_field_tag :per_page, @facturas_per_page %>
          <%= select_tag :status,
                         options_for_select([["Todos los estados", ""]] + Factura::ESTADOS.map { |estado| [estado.humanize, estado] }, @filters[:status]),
                         class: "filter-select" %>
          <%= submit_tag "Aplicar filtros", class: "ui-button ui-button-primary submit-button" %>
          <%= link_to "Limpiar", facturas_path, class: "ui-button ui-button-secondary" %>
        </div>
      </div>
    <% end %>
  </section>

  <section class="panel user-index-panel user-index-table-panel">
    <div class="panel-header">
      <h2>Listado de facturas</h2>
      <div class="page-actions-inline">
        <%= link_to "Nueva factura", new_factura_path, class: "ui-button ui-button-primary" %>
      </div>
    </div>

    <% if @facturas.any? %>
      <div class="table-shell user-index-table-shell">
        <table class="data-table facturas-table">
          <thead>
            <tr>
              <th>Número</th>
              <th>Serie</th>
              <th>Cliente</th>
              <th>Emisión</th>
              <th>Total</th>
              <th>Estado</th>
              <th>Acciones</th>
            </tr>
          </thead>
          <tbody>
            <% @facturas.each do |factura| %>
              <tr>
                <td class="user-index-name"><%= factura.numero_visible %></td>
                <td><%= factura.serie.presence || "-" %></td>
                <td class="user-index-email"><%= factura.cliente_nombre %></td>
                <td><%= factura.fecha_emision || "-" %></td>
                <td class="roles-users-count"><%= factura.total_formateado %></td>
                <td><span class="user-index-chip <%= factura.activo? ? "user-index-chip-success" : "user-index-chip-warning" %>"><%= factura.activo? ? factura.estado.humanize : "Inactiva" %></span></td>
                <td class="table-actions">
                  <%= table_action_link "Ver", factura_path(factura), action: :view %>
                  <%= table_action_link "Editar", edit_factura_path(factura), action: :edit %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>

      <div class="table-pagination">
        <div class="pagination-controls">
          <%= form_with url: facturas_path, method: :get, class: "pagination-size-form" do %>
            <%= hidden_field_tag :query, @filters[:query] if @filters[:query].present? %>
            <%= hidden_field_tag :status, @filters[:status] if @filters[:status].present? %>
            <label for="facturas_per_page">Resultados</label>
            <%= select_tag :per_page,
                           options_for_select([[10, 10], [20, 20], [50, 50], [100, 100]], @facturas_per_page),
                           id: "facturas_per_page",
                           class: "filter-select pagination-size-select",
                           onchange: "this.form.submit()" %>
          <% end %>

          <nav class="pagination-nav" aria-label="Paginación de facturas">
            <% pagination_params = request.query_parameters.except("page").merge(per_page: @facturas_per_page) %>
            <%= link_to "Anterior", facturas_path(pagination_params.merge(page: @facturas_page - 1)), class: "ui-button ui-button-secondary pagination-button #{'is-disabled' if @facturas_page <= 1}", aria: { disabled: @facturas_page <= 1 } %>
            <span class="pagination-current">Página <%= @facturas_page %> de <%= @facturas_total_pages %></span>
            <%= link_to "Siguiente", facturas_path(pagination_params.merge(page: @facturas_page + 1)), class: "ui-button ui-button-secondary pagination-button #{'is-disabled' if @facturas_page >= @facturas_total_pages}", aria: { disabled: @facturas_page >= @facturas_total_pages } %>
          </nav>
        </div>
      </div>
    <% else %>
      <%= render "shared/empty_state",
                 title: @filters.values.any?(&:present?) ? "No se encontraron facturas" : "No hay facturas registradas",
                 description: @filters.values.any?(&:present?) ? "Ajusta la búsqueda o limpia los filtros para ver más resultados." : "Registra facturas para controlar emisión, vencimiento y estado de pago." %>
    <% end %>
  </section>
</section>
