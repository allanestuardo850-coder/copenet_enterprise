<section class="page-section user-module-page user-index-page enterprise-module-index-page">
  <section class="panel filters-panel user-index-panel user-index-filters-panel">
    <div class="filters-bar">
      <label class="search-shell inline-search-shell">
        <span class="search-icon"><%= icon("search") %></span>
        <input type="search" placeholder="Buscar en <%= @page_title.downcase %>" aria-label="Buscar en <%= @page_title.downcase %>">
      </label>
      <div class="filter-chip-list filter-select-list">
        <% @page_filters.each do |filter| %>
          <select class="filter-select" aria-label="<%= filter %>">
            <option><%= filter %></option>
          </select>
        <% end %>
        <button type="button" class="ui-button ui-button-primary submit-button">Aplicar filtros</button>
        <button type="button" class="ui-button ui-button-secondary">Limpiar</button>
      </div>
    </div>
  </section>

  <section class="panel user-index-panel user-index-table-panel">
    <div class="panel-header">
      <h2>Listado de <%= @page_title.downcase %></h2>
      <div class="page-actions-inline">
        <%= render "shared/button", label: @page_action[:label], href: @page_action[:href], variant: "primary" %>
      </div>
    </div>

    <% if @table_rows.any? %>
      <div class="table-shell user-index-table-shell">
        <table class="data-table enterprise-module-table">
          <thead>
            <tr>
              <% @table_columns.each do |column| %>
                <th><%= column %></th>
              <% end %>
              <th>Acciones</th>
            </tr>
          </thead>
          <tbody>
            <% @table_rows.each do |row| %>
              <tr>
                <% row.each_with_index do |cell, index| %>
                  <% if index.zero? %>
                    <td class="user-index-name"><%= cell %></td>
                  <% elsif index == row.length - 2 %>
                    <td><span class="user-index-chip <%= status_badge_tone(cell) == "success" ? "user-index-chip-success" : "user-index-chip-level" %>"><%= cell %></span></td>
                  <% elsif index == row.length - 1 %>
                    <td class="roles-users-count"><%= cell %></td>
                  <% else %>
                    <td><%= cell %></td>
                  <% end %>
                <% end %>
                <td class="table-actions">
                  <%= link_to icon("eye"), "#", class: "table-link table-action-icon table-action-view", title: "Ver", aria: { label: "Ver" } %>
                  <%= link_to icon("pencil"), "#", class: "table-link table-action-icon table-action-edit", title: "Editar", aria: { label: "Editar" } %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <%= render "shared/empty_state",
                 title: @empty_state[:title],
                 description: @empty_state[:description] %>
    <% end %>
  </section>
</section>
