<% content_for :body_class, "dashboard-reference-shell" %>

<section class="page-section dashboard-page">
  <div class="kpi-grid dash-kpi-grid">
    <% @kpis.each do |kpi| %>
      <%= render "shared/kpi_card", kpi: kpi %>
    <% end %>
  </div>

  <div class="dashboard-grid">
    <div class="panel chart-panel chart-panel-wide"
         data-controller="dashboard-finance"
         data-dashboard-finance-url-value="<%= dashboard_finance_path %>"
         data-dashboard-finance-active-class="is-active">
      <div class="panel-header">
        <div>
          <h2>Resumen financiero mensual</h2>
        </div>
        <div class="seg-toggle" role="group" aria-label="Rango de tiempo">
          <button type="button" class="seg-item is-active" data-dashboard-finance-target="button" data-range="current" data-action="dashboard-finance#load">Mes actual</button>
          <button type="button" class="seg-item" data-dashboard-finance-target="button" data-range="6" data-action="dashboard-finance#load">6 meses</button>
          <button type="button" class="seg-item" data-dashboard-finance-target="button" data-range="12" data-action="dashboard-finance#load">12 meses</button>
        </div>
      </div>
      <div class="chart-legend">
        <span class="legend-item"><i class="legend-swatch" style="background: var(--primary)"></i>Ingresos</span>
        <span class="legend-item"><i class="legend-swatch" style="background: var(--primary); opacity: 0.3"></i>Costos</span>
        <span class="legend-item"><i class="legend-line" style="background: var(--success)"></i>Utilidad</span>
      </div>
      <div class="chart-body" data-dashboard-finance-target="chart">
        <%= dashboard_barline_chart(**@finance) %>
      </div>
    </div>

    <aside class="panel pendientes-panel">
      <div class="panel-header">
        <div>
          <h2>Pendientes críticos</h2>
        </div>
      </div>
      <div class="pendientes-list">
        <% @pendientes.each do |item| %>
          <article class="pendiente-item">
            <span class="pendiente-icon kpi-icon-<%= item[:tone] %>"><%= icon(item[:icon]) %></span>
            <div class="pendiente-body">
              <h3><%= item[:title] %></h3>
              <p><%= item[:detail] %></p>
            </div>
            <%= render "shared/badge", text: item[:status], tone: item[:tone] %>
          </article>
        <% end %>
      </div>
    </aside>
  </div>

  <div class="dashboard-split">
    <div class="panel cartera-panel">
      <div class="panel-header">
        <div>
          <h2>Estado de cartera</h2>
        </div>
      </div>
      <div class="cartera-body">
        <div class="cartera-donut">
          <%= dashboard_donut_chart(segments: @cartera[:segments]) %>
        </div>
        <div class="cartera-legend">
          <% @cartera[:segments].each do |seg| %>
            <div class="cartera-row">
              <span class="cartera-label"><i class="legend-dot" style="background: <%= tone_color(seg[:tone]) %>"></i><%= seg[:label] %></span>
              <span class="cartera-value"><%= seg[:display] %></span>
              <span class="cartera-pct"><%= seg[:pct] %></span>
            </div>
          <% end %>
          <div class="cartera-row cartera-total">
            <span class="cartera-label">Total cartera</span>
            <span class="cartera-value"><%= @cartera[:total] %></span>
            <span class="cartera-pct"></span>
          </div>
        </div>
      </div>
    </div>

    <div class="panel tendencia-panel">
      <div class="panel-header">
        <div class="trend-title-row">
          <h2>Tendencia de facturación</h2>
          <div class="chart-legend trend-inline-legend">
            <% @tendencia[:series].each do |serie| %>
              <span class="legend-item"><i class="legend-line" style="background: <%= tone_color(serie[:tone]) %>"></i><%= serie[:label] %></span>
            <% end %>
          </div>
        </div>
        <div class="trend-stats">
          <% @tendencia[:series].each do |serie| %>
            <div class="trend-stat trend-stat-<%= serie[:tone] %>">
              <span class="trend-stat-label"><%= serie[:label] %></span>
              <span class="trend-stat-value"><%= serie[:total] %></span>
            </div>
          <% end %>
        </div>
      </div>
      <div class="chart-body">
        <%= dashboard_trend_chart(months: @tendencia[:months], series: @tendencia[:series], max: @tendencia[:max]) %>
      </div>
    </div>
  </div>

  <section class="page-subsection">
    <div class="section-heading quick-heading-panel">
      <div>
        <h2>Accesos rápidos</h2>
      </div>
    </div>

    <div class="quick-grid">
      <% quick_tones = %w[primary success info warning primary success info primary success] %>
      <% @modules.each_with_index do |mod, i| %>
        <%= link_to mod[:href], class: "quick-card" do %>
          <span class="kpi-icon kpi-icon-<%= quick_tones[i % quick_tones.size] %>"><%= icon(mod[:icon]) %></span>
          <span class="quick-label"><%= mod[:title] %></span>
        <% end %>
      <% end %>
    </div>
  </section>
</section>
