<%= form_with model: moneda, class: "company-form" do |form| %>
  <% if moneda.errors.any? %>
    <section class="panel form-errors">
      <ul class="error-list">
        <% moneda.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </section>
  <% end %>

  <section class="panel product-tabs-panel">
    <div class="panel-header">
      <div>
        <h2>Configuración de la moneda</h2>
      </div>
      <div class="form-actions company-form-header-actions">
        <%= form.submit "Guardar", class: "ui-button ui-button-primary submit-button" %>
        <%= link_to "Cancelar", monedas_path, class: "ui-button ui-button-secondary" %>
      </div>
    </div>
  </section>

  <section class="panel form-section">
    <div class="panel-header">
      <div>
        <h2>Información de la moneda</h2>
      </div>
    </div>

    <div class="form-grid">
      <div class="field-group">
        <%= form.label :codigo, "Código" %>
        <%= form.number_field :codigo, class: "text-input", min: 1, step: 1, placeholder: "320" %>
      </div>

      <div class="field-group">
        <%= form.label :nombre, "Nombre" %>
        <%= form.text_field :nombre, class: "text-input", placeholder: "Quetzal" %>
      </div>

      <div class="field-group">
        <%= form.label :simbolo, "Símbolo" %>
        <%= form.text_field :simbolo, class: "text-input", placeholder: "Q" %>
      </div>

      <% if moneda.persisted? %>
        <div class="field-group checkbox-group">
          <label class="checkbox-label">
            <%= hidden_field_tag "moneda[activo]", "1" %>
            <%= check_box_tag "moneda[activo]", "0", !moneda.activo? %>
            <span>Inactivar</span>
          </label>
        </div>
      <% else %>
        <%= form.hidden_field :activo, value: true %>
      <% end %>
    </div>
  </section>
<% end %>
