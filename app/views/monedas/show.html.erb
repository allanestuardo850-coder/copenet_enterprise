<section class="page-section company-show-page">
  <section class="company-show-hero">
    <div class="company-show-identity">
      <div class="company-show-logo">
        <%= @moneda.simbolo.presence || @moneda.nombre.to_s.first(2).upcase %>
      </div>

      <div class="company-show-copy">
        <div class="company-show-title-row">
          <strong class="company-show-title"><%= @moneda.nombre %></strong>

          <div class="company-show-badges">
            <%= render "shared/badge", text: @moneda.activo? ? "Activa" : "Inactiva", tone: @moneda.activo? ? "success" : "warning" %>
          </div>
        </div>

        <p><%= @moneda.simbolo %> · Código <%= @moneda.codigo %></p>
      </div>
    </div>

    <div class="company-show-actions" aria-label="Acciones de moneda">
      <%= link_to "#{icon("chevron")}<span>Volver</span>".html_safe, monedas_path, class: "company-show-action-button company-show-back-button", data: { turbo: false }, title: "Volver al listado", aria: { label: "Volver al listado" } %>
      <%= link_to "#{icon("pencil")}<span>Editar</span>".html_safe, edit_moneda_path(@moneda), class: "company-show-action-button company-show-action-primary", title: "Editar moneda", aria: { label: "Editar moneda" } %>
    </div>
  </section>

  <section class="panel detail-section">
    <div class="panel-header">
      <div>
        <h2>Información de la moneda</h2>
      </div>
    </div>

    <div class="detail-grid">
      <div class="detail-item"><span>Código</span><strong><%= @moneda.codigo %></strong></div>
      <div class="detail-item"><span>Nombre</span><strong><%= @moneda.nombre %></strong></div>
      <div class="detail-item"><span>Símbolo</span><strong><%= @moneda.simbolo %></strong></div>
      <div class="detail-item"><span>Estado</span><strong><%= @moneda.activo? ? "Activa" : "Inactiva" %></strong></div>
    </div>
  </section>
</section>
