<section class="login-shell">
  <div class="login-brand-panel">
    <div class="login-particles" aria-hidden="true">
      <span class="particle particle-1"></span>
      <span class="particle particle-2"></span>
      <span class="particle particle-3"></span>
      <span class="particle particle-4"></span>
      <span class="particle particle-5"></span>
      <span class="particle particle-6"></span>
    </div>
    <div class="login-orbit login-orbit-a" aria-hidden="true"></div>
    <div class="login-orbit login-orbit-b" aria-hidden="true"></div>
    <div class="login-brand-mark">
      <% if (logo_login = branding_image(:logo_login, css_class: "login-brand-image", alt: branding_texto(:nombre_plataforma, "Copenet Enterprise"))).present? %>
        <%= logo_login %>
      <% else %>
        <%= branding_texto(:nombre_principal, "COPENET").to_s.first %>
      <% end %>
    </div>
    <p class="eyebrow"><%= branding_texto(:login_eyebrow, "Copenet Enterprise") %></p>
    <h1><%= branding_texto(:login_titulo, "Control empresarial con una base moderna y segura") %></h1>
    <p><%= branding_texto(:login_subtitulo, "Plataforma empresarial para administración, costos, cobros y control operativo.") %></p>
    <div class="login-pattern"></div>
  </div>

  <div class="login-form-panel">
    <div class="login-form-card">
      <div class="login-heading">
        <h2>Iniciar Sesión</h2>
        <p>Accede al panel administrativo con tu cuenta interna.</p>
      </div>

      <%= form_with url: login_path, class: "login-form" do |form| %>
        <div class="field-group">
          <%= form.label :email, "Correo Electrónico" %>
          <%= form.email_field :email, class: "text-input", autofocus: true, required: true %>
        </div>

        <div class="field-group">
          <%= form.label :password, "Contraseña" %>
          <%= form.password_field :password, class: "text-input", required: true %>
        </div>

        <label class="checkbox-label login-checkbox">
          <%= check_box_tag :remember_me, "1", false %>
          <span>Recordarme en este equipo</span>
        </label>

        <%= form.submit "Iniciar Sesión", class: "ui-button ui-button-primary submit-button login-submit" %>
      <% end %>
    </div>
  </div>
</section>
