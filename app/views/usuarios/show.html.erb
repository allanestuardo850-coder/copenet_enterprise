<section class="page-section user-admin-page user-show-page" data-controller="tabs" data-tabs-default-value="actividad">
  <section class="panel user-show-hero">
    <div class="user-show-hero-top">
      <div class="user-show-identity">
        <div class="user-show-avatar"><%= @usuario.nombre_completo.to_s.first(2).upcase %></div>
        <div class="user-show-heading">
          <h1><%= @usuario.nombre_completo %></h1>
          <p><%= @usuario.email %></p>
          <div class="user-profile-badges">
            <%= render "shared/badge", text: @usuario.activo? ? "Activo" : "Inactivo", tone: @usuario.activo? ? "success" : "warning" %>
            <%= render "shared/badge", text: @usuario.root? ? "Root" : @usuario.roles.first&.nombre.presence || "Estándar", tone: @usuario.root? ? "primary" : "info" %>
          </div>
        </div>
      </div>

      <div class="user-profile-actions">
        <%= link_to "Volver", usuarios_path, class: "ui-button ui-button-secondary" %>
        <%= link_to "Editar", edit_usuario_path(@usuario), class: "ui-button ui-button-primary" %>
      </div>
    </div>

    <div class="user-show-profile-section">
      <h2>Información del perfil</h2>
      <div class="user-show-info-grid">
        <article class="user-show-info-item">
          <span class="user-show-info-icon"><%= icon("message") %></span>
          <div>
            <small>Correo</small>
            <strong><%= @usuario.email %></strong>
          </div>
        </article>

        <article class="user-show-info-item">
          <span class="user-show-info-icon"><%= icon("user") %></span>
          <div>
            <small>Nombre</small>
            <strong><%= @usuario.nombre_completo %></strong>
          </div>
        </article>

        <article class="user-show-info-item">
          <span class="user-show-info-icon"><%= icon("contract") %></span>
          <div>
            <small>Cargo</small>
            <strong><%= usuario_valor(nil) %></strong>
          </div>
        </article>

        <article class="user-show-info-item">
          <span class="user-show-info-icon"><%= icon("building") %></span>
          <div>
            <small>Área de la empresa</small>
            <strong><%= usuario_valor(nil) %></strong>
          </div>
        </article>

        <article class="user-show-info-item">
          <span class="user-show-info-icon"><%= icon("message") %></span>
          <div>
            <small>Teléfono</small>
            <strong><%= usuario_valor(nil) %></strong>
          </div>
        </article>
      </div>
    </div>
  </section>

  <section class="user-show-tab-grid">
    <button type="button" class="module-tab user-show-main-tab is-active" data-tabs-target="tab" data-tab-id="actividad" data-action="tabs#switch" role="tab" aria-selected="true">
      <span class="module-tab-icon"><%= icon("report") %></span>
      <span class="module-tab-copy">
        <strong>Actividad</strong>
        <small>Eventos recientes</small>
      </span>
    </button>

    <button type="button" class="module-tab user-show-main-tab" data-tabs-target="tab" data-tab-id="permisos" data-action="tabs#switch" role="tab" aria-selected="false">
      <span class="module-tab-icon"><%= icon("shield") %></span>
      <span class="module-tab-copy">
        <strong>Permisos</strong>
        <small><%= @modulo_sistemas.size %> módulos configurables</small>
      </span>
    </button>
  </section>

  <section class="panel module-tab-panel user-show-activity-panel is-active" data-tabs-target="panel" data-tab-id="actividad">
    <div class="panel-header">
      <div>
        <h2>Actividad por módulo</h2>
      </div>
    </div>

    <div data-controller="subtabs" data-subtabs-default-value="todas">
      <div class="user-show-filter-tabs" role="tablist" aria-label="Filtros de actividad">
        <button type="button" class="is-active" data-subtabs-target="tab" data-tab-id="todas" data-action="subtabs#switch" role="tab" aria-selected="true">Todos</button>
        <% @actividad_grupos.each do |group| %>
          <button type="button" data-subtabs-target="tab" data-tab-id="<%= group[:id] %>" data-action="subtabs#switch" role="tab" aria-selected="false"><%= group[:title] %></button>
        <% end %>
      </div>

      <section class="user-show-activity-tab-panel is-active" data-subtabs-target="panel" data-tab-id="todas">
        <% visible_groups = @actividad_grupos.select { |group| group[:items].any? } %>
        <% if visible_groups.any? %>
          <div class="user-show-activity-list">
            <% visible_groups.each do |group| %>
              <section class="user-show-activity-group">
                <h3><%= group[:title] %></h3>
                <% group[:items].each do |item| %>
                  <div class="user-show-activity-row">
                    <span class="user-show-activity-icon"><%= icon(item[:icon]) %></span>
                    <div class="user-show-activity-copy">
                      <strong><%= item[:label] %></strong>
                      <% if item[:detail].present? %>
                        <span><%= item[:detail] %></span>
                      <% end %>
                    </div>
                    <time><%= item[:value] %></time>
                  </div>
                <% end %>
              </section>
            <% end %>
          </div>
        <% else %>
          <div class="empty-inline-state user-show-empty-activity">
            <strong>Sin actividad</strong>
            <span>No hay eventos registrados para este usuario.</span>
          </div>
        <% end %>
      </section>

      <% @actividad_grupos.each do |group| %>
        <section class="user-show-activity-tab-panel" data-subtabs-target="panel" data-tab-id="<%= group[:id] %>" hidden>
          <% if group[:items].any? %>
            <div class="user-show-activity-list">
              <section class="user-show-activity-group">
                <h3><%= group[:title] %></h3>
                <% group[:items].each do |item| %>
                  <div class="user-show-activity-row">
                    <span class="user-show-activity-icon"><%= icon(item[:icon]) %></span>
                    <div class="user-show-activity-copy">
                      <strong><%= item[:label] %></strong>
                      <% if item[:detail].present? %>
                        <span><%= item[:detail] %></span>
                      <% end %>
                    </div>
                    <time><%= item[:value] %></time>
                  </div>
                <% end %>
              </section>
            </div>
          <% else %>
            <div class="empty-inline-state user-show-empty-activity">
              <strong>Sin actividad</strong>
              <span>No hay eventos registrados en <%= group[:title].downcase %>.</span>
            </div>
          <% end %>
        </section>
      <% end %>
    </div>
  </section>

  <section class="panel module-tab-panel user-permissions-panel" data-tabs-target="panel" data-tab-id="permisos" hidden>
    <%= form_with url: permisos_usuario_path(@usuario), method: :patch, class: "company-form", data: { controller: "usuario-permisos" } do %>
      <div class="panel-header">
        <div>
          <h2>Permisos del usuario</h2>
        </div>
        <span class="permission-save-state" data-usuario-permisos-target="status" data-state="idle">Listo</span>
      </div>

      <% if @usuario.root? %>
        <section class="root-permissions-card">
          <div class="root-permissions-icon"><%= icon("shield") %></div>
          <div>
            <h3>Acceso total habilitado</h3>
            <p>Este usuario es root y nace con todos los permisos activos. Puedes ajustar permisos específicos desde esta tabla si necesitas registrar una configuración personalizada.</p>
          </div>
        </section>
      <% end %>

      <% first_permission_tab = @modulo_sistemas_por_grupo.keys.first.to_s.parameterize.presence || "permisos" %>
      <div data-controller="subtabs" data-subtabs-default-value="<%= first_permission_tab %>">
        <div class="permission-tabs" role="tablist" aria-label="Grupos de permisos">
          <% @modulo_sistemas_por_grupo.each_with_index do |(grupo, _modulos), index| %>
            <% tab_id = grupo.to_s.parameterize.presence || "grupo-#{index + 1}" %>
            <button type="button"
                    class="permission-tab <%= 'is-active' if index.zero? %>"
                    data-subtabs-target="tab"
                    data-tab-id="<%= tab_id %>"
                    data-action="subtabs#switch"
                    role="tab"
                    aria-selected="<%= index.zero? ? 'true' : 'false' %>">
              <span><%= grupo %></span>
            </button>
          <% end %>
        </div>

        <% @modulo_sistemas_por_grupo.each_with_index do |(grupo, modulos), index| %>
          <% tab_id = grupo.to_s.parameterize.presence || "grupo-#{index + 1}" %>
          <section class="permission-tab-panel <%= 'is-active' if index.zero? %>"
                   data-subtabs-target="panel"
                   data-tab-id="<%= tab_id %>"
                   <%= "hidden" unless index.zero? %>>
            <div class="permission-tab-header">
              <h3><%= grupo %></h3>
              <label class="permission-all-toggle">
                <%= check_box_tag nil,
                                  "1",
                                  modulos.all? { |modulo| UsuariosHelper::ACCIONES_PERMISO.all? { |accion| permiso_personalizado_usuario(@usuario, modulo, accion).then { |personalizado| personalizado.nil? ? permiso_base_usuario(@usuario, modulo, accion) : personalizado } } },
                                  data: { action: "change->usuario-permisos#toggleAll" } %>
                <span>Todos</span>
              </label>
            </div>

            <div class="table-shell">
              <table class="data-table permisos-table permisos-usuario-table">
                <thead>
                  <tr>
                    <th>Módulo / Función</th>
                    <th>Código</th>
                    <th>Estado</th>
                    <% UsuariosHelper::ACCIONES_PERMISO.each do |accion| %>
                      <th><%= permiso_accion_label(accion) %></th>
                    <% end %>
                  </tr>
                </thead>
                <tbody>
                  <% modulos.each do |modulo| %>
                    <tr data-modulo-id="<%= modulo.id %>">
                      <td>
                        <div class="permission-module-cell">
                          <strong><%= modulo.nombre %></strong>
                          <span><%= modulo.descripcion.presence || "Módulo listo para administración y control de accesos." %></span>
                        </div>
                      </td>
                      <td><%= modulo.codigo %></td>
                      <td>
                        <span class="permission-save-state" data-state="<%= modulo.activo? ? "saved" : "error" %>"><%= modulo.activo? ? "Activo" : "Inactivo" %></span>
                      </td>
                      <% UsuariosHelper::ACCIONES_PERMISO.each do |accion| %>
                        <% checked = permiso_personalizado_usuario(@usuario, modulo, accion).then { |personalizado| personalizado.nil? ? permiso_base_usuario(@usuario, modulo, accion) : personalizado } %>
                        <td>
                          <%= check_box_tag "usuario_permisos[#{modulo.id}][puede_#{accion}]",
                                            "1",
                                            checked,
                                            data: {
                                              action: "change->usuario-permisos#toggle",
                                              permission_action: "puede_#{accion}"
                                            } %>
                        </td>
                      <% end %>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            </div>
          </section>
        <% end %>
      </div>
    <% end %>
  </section>
</section>
