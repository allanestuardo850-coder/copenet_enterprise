<%= form_with(model: usuario,
              class: "company-form",
              data: {
                controller: "tabs usuario-inactivation",
                tabs_default_value: "general",
                usuario_inactivation_original_inactive_value: !usuario.activo?
              }) do |form| %>
  <% if usuario.errors.any? %>
    <section class="panel form-errors">
      <ul class="error-list">
        <% usuario.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </section>
  <% end %>

  <section class="panel product-tabs-panel">
    <div class="panel-header">
      <div>
        <h2>Configuración del usuario</h2>
      </div>
      <div class="form-actions company-form-header-actions">
        <%= form.submit "Guardar", class: "ui-button ui-button-primary submit-button" %>
        <%= link_to "Cancelar", usuarios_path, class: "ui-button ui-button-secondary" %>
      </div>
    </div>

    <div class="module-tabs" role="tablist" aria-label="Secciones del formulario de usuario">
      <button type="button" class="module-tab is-active" data-tabs-target="tab" data-tab-id="general" data-action="tabs#switch" role="tab" aria-selected="true">
        <span class="module-tab-icon"><%= icon("users") %></span>
        <span class="module-tab-copy">
          <strong>General</strong>
          <small>Datos del usuario</small>
        </span>
      </button>
      <button type="button" class="module-tab" data-tabs-target="tab" data-tab-id="seguridad" data-action="tabs#switch" role="tab" aria-selected="false">
        <span class="module-tab-icon"><%= icon("shield") %></span>
        <span class="module-tab-copy">
          <strong>Seguridad</strong>
          <small>Credenciales</small>
        </span>
      </button>
      <button type="button" class="module-tab" data-tabs-target="tab" data-tab-id="roles" data-action="tabs#switch" role="tab" aria-selected="false">
        <span class="module-tab-icon"><%= icon("layers") %></span>
        <span class="module-tab-copy">
          <strong>Roles</strong>
          <small>Alcance funcional</small>
        </span>
      </button>
    </div>
  </section>

  <section class="panel form-section module-tab-panel is-active" data-tabs-target="panel" data-tab-id="general">
    <div class="panel-header">
      <div>
        <h2>Información general</h2>
      </div>
    </div>

    <div class="form-grid">
      <div class="field-group">
        <%= form.label :nombre, "Nombre" %>
        <%= form.text_field :nombre, class: "text-input", placeholder: "Mario" %>
      </div>
      <div class="field-group">
        <%= form.label :apellido, "Apellido" %>
        <%= form.text_field :apellido, class: "text-input", placeholder: "Montúfar" %>
      </div>
      <div class="field-group field-group-full">
        <%= form.label :email, "Correo Electrónico" %>
        <%= form.email_field :email, class: "text-input", placeholder: "usuario@copenet.com.gt" %>
      </div>
      <div class="field-group checkbox-group">
        <label class="checkbox-label">
          <%= hidden_field_tag "usuario[activo]", "1" %>
          <%= check_box_tag "usuario[activo]",
                            "0",
                            !usuario.activo?,
                            data: { usuario_inactivation_target: "inactiveInput" } %>
          <span>Inactivar</span>
        </label>
      </div>
      <div class="field-group checkbox-group">
        <label class="checkbox-label">
          <%= form.check_box :root %>
          <span>Acceso root</span>
        </label>
      </div>
    </div>
  </section>

  <section class="panel form-section module-tab-panel" data-tabs-target="panel" data-tab-id="seguridad" hidden>
    <div class="panel-header">
      <div>
        <h2>Seguridad y credenciales</h2>
      </div>
    </div>

    <div class="form-grid">
      <div class="field-group">
        <%= form.label :password, "Contraseña" %>
        <%= form.password_field :password, class: "text-input", placeholder: usuario.persisted? ? "Dejar vacío para conservar" : "Contraseña inicial" %>
      </div>
      <div class="field-group">
        <%= form.label :password_confirmation, "Confirmar Contraseña" %>
        <%= form.password_field :password_confirmation, class: "text-input", placeholder: "Repite la contraseña" %>
      </div>
    </div>
  </section>

  <section class="panel form-section module-tab-panel" data-tabs-target="panel" data-tab-id="roles" hidden>
    <div class="panel-header">
      <div>
        <h2>Roles y alcance operativo</h2>
      </div>
      <%= render "shared/badge", text: "#{@roles.size} roles disponibles", tone: "info" %>
    </div>

    <div class="checkbox-list checkbox-role-grid">
      <% rol_actual_id = usuario.roles.first&.id %>
      <% @roles.each do |rol| %>
        <label class="checkbox-label checkbox-card role-select-card">
          <%= radio_button_tag "usuario[rol_id]", rol.id, rol.id == rol_actual_id %>
          <span><strong><%= rol.nombre %></strong><small><%= rol.descripcion.presence || "Rol disponible para administración interna." %></small></span>
        </label>
      <% end %>
    </div>
  </section>

  <% if usuario.persisted? %>
    <div class="confirm-modal-backdrop" data-usuario-inactivation-target="modal" hidden>
      <div class="confirm-modal" role="dialog" aria-modal="true" aria-labelledby="usuario-inactivation-title">
        <div class="confirm-modal-icon"><%= icon("alert") %></div>
        <div class="confirm-modal-copy">
          <h2 id="usuario-inactivation-title">Confirmar inactivación</h2>
          <p>Al inactivar este usuario, ya no podrá ingresar ni operar dentro de la plataforma.</p>
        </div>
        <div class="confirm-modal-actions">
          <button type="button" class="ui-button ui-button-secondary" data-action="usuario-inactivation#cancel">Cancelar</button>
          <button type="button" class="ui-button ui-button-primary" data-action="usuario-inactivation#confirm">Confirmar y guardar</button>
        </div>
      </div>
    </div>
  <% end %>
<% end %>
