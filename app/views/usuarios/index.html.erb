<section class="page-section user-module-page user-index-page">
  <section class="panel filters-panel user-index-panel user-index-filters-panel">
    <%= form_with url: usuarios_path, method: :get, class: "filters-form" do %>
      <div class="filters-bar">
        <label class="search-shell inline-search-shell">
          <span class="search-icon"><%= icon("search") %></span>
          <%= text_field_tag :query, @filters[:query], placeholder: "Buscar por nombre, apellido o correo" %>
        </label>
        <div class="filter-chip-list filter-select-list">
          <%= hidden_field_tag :per_page, @usuarios_per_page %>
          <%= select_tag :status,
                         options_for_select([["Todos los estados", ""], ["Activos", "activo"], ["Inactivos", "inactivo"]], @filters[:status]),
                         class: "filter-select" %>
          <%= select_tag :root,
                         options_for_select([["Todos los niveles", ""], ["Root", "si"], ["No root", "no"]], @filters[:root]),
                         class: "filter-select" %>
          <%= submit_tag "Aplicar filtros", class: "ui-button ui-button-primary submit-button" %>
          <%= link_to "Limpiar", usuarios_path, class: "ui-button ui-button-secondary" %>
        </div>
      </div>
    <% end %>
  </section>

  <section class="panel user-index-panel user-index-table-panel">
    <div class="panel-header">
      <h2>Listado de Usuarios</h2>
      <div class="page-actions-inline">
        <%= link_to "Nuevo usuario", new_usuario_path, class: "ui-button ui-button-primary" %>
      </div>
    </div>

    <% if @usuarios.any? %>
      <div class="table-shell user-index-table-shell">
        <table class="data-table usuarios-table">
          <thead>
            <tr>
              <th>Fotografía</th>
              <th>Nombre del usuario</th>
              <th>Correo electrónico</th>
              <th>Rol</th>
              <th>Estado</th>
              <th>Nivel</th>
              <th>Último acceso</th>
              <th>Acciones</th>
            </tr>
          </thead>
          <tbody>
            <% @usuarios.each do |usuario| %>
              <% rol_principal = usuario.roles.first %>
              <tr>
                <td>
                  <div class="user-index-avatar">
                    <%= usuario.nombre.to_s.first&.upcase %><%= usuario.apellido.to_s.first&.upcase %>
                  </div>
                </td>
                <td class="user-index-name"><%= usuario.nombre_completo %></td>
                <td class="user-index-email"><%= usuario.email %></td>
                <td><span class="user-index-chip user-index-chip-primary"><%= rol_principal&.nombre || "Sin rol" %></span></td>
                <td><span class="user-index-chip user-index-chip-success"><%= usuario.activo? ? "Activo" : "Inactivo" %></span></td>
                <td><span class="user-index-chip user-index-chip-level"><%= usuario.root? ? "Root" : "Estándar" %></span></td>
                <td class="user-index-date"><%= usuario_fecha(usuario.ultimo_acceso_en) %></td>
                <td class="table-actions">
                  <%= table_action_link "Ver", usuario_path(usuario), action: :view %>
                  <%= table_action_link "Editar", edit_usuario_path(usuario), action: :edit %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>

      <div class="table-pagination">
        <div class="pagination-controls">
          <%= form_with url: usuarios_path, method: :get, class: "pagination-size-form" do %>
            <%= hidden_field_tag :query, @filters[:query] if @filters[:query].present? %>
            <%= hidden_field_tag :status, @filters[:status] if @filters[:status].present? %>
            <%= hidden_field_tag :root, @filters[:root] if @filters[:root].present? %>
            <label for="usuarios_per_page">Resultados</label>
            <%= select_tag :per_page,
                           options_for_select([[10, 10], [20, 20], [50, 50], [100, 100]], @usuarios_per_page),
                           id: "usuarios_per_page",
                           class: "filter-select pagination-size-select",
                           onchange: "this.form.submit()" %>
          <% end %>

          <nav class="pagination-nav" aria-label="Paginación de usuarios">
          <% pagination_params = request.query_parameters.except("page").merge(per_page: @usuarios_per_page) %>
          <%= link_to "Anterior",
                      usuarios_path(pagination_params.merge(page: @usuarios_page - 1)),
                      class: "ui-button ui-button-secondary pagination-button #{'is-disabled' if @usuarios_page <= 1}",
                      aria: { disabled: @usuarios_page <= 1 } %>

          <span class="pagination-current">Página <%= @usuarios_page %> de <%= @usuarios_total_pages %></span>

          <%= link_to "Siguiente",
                      usuarios_path(pagination_params.merge(page: @usuarios_page + 1)),
                      class: "ui-button ui-button-secondary pagination-button #{'is-disabled' if @usuarios_page >= @usuarios_total_pages}",
                      aria: { disabled: @usuarios_page >= @usuarios_total_pages } %>
          </nav>
        </div>
      </div>
    <% else %>
      <%= render "shared/empty_state",
                 title: "No hay usuarios registrados",
                 description: "Crea el primer usuario para comenzar a configurar accesos, roles y permisos operativos." %>
    <% end %>
  </section>
</section>
