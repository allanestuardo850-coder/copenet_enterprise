<header class="topbar">
  <div class="topbar-left">
    <button class="icon-button sidebar-toggle-button" type="button" data-action="shell#toggleSidebar" aria-label="Mostrar u ocultar menú lateral">
      <%= icon("menu") %>
    </button>
    <div class="search-shell">
      <span class="search-icon"><%= icon("search") %></span>
      <input type="search" placeholder="<%= branding_texto(:placeholder_busqueda, 'Buscar empresas, cuentas o reportes') %>" aria-label="Buscar en la plataforma">
      <span class="search-shortcut">⌘K</span>
    </div>
  </div>

  <div class="topbar-right">
    <button class="icon-button notification-button" type="button">
      <%= icon("bell") %>
      <span class="notification-ping"></span>
    </button>
    <button class="icon-button" type="button" aria-label="Mensajes">
      <%= icon("message") %>
    </button>
    <button class="icon-button" type="button" aria-label="Aplicaciones">
      <%= icon("grid") %>
    </button>
    <button class="icon-button theme-toggle-button" type="button" data-action="shell#toggleTheme" aria-label="Cambiar tema">
      <span class="theme-icons">
        <%= icon("sun") %>
        <%= icon("moon") %>
      </span>
      <span class="theme-toggle-label" data-shell-target="themeLabel">Light</span>
    </button>

    <%= render "shared/user_menu" %>
  </div>
</header>
