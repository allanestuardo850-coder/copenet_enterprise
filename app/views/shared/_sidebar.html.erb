<aside class="sidebar" data-shell-target="sidebar">
  <% logo_alt = branding_texto(:nombre_plataforma, "Copenet") %>
  <% logo_sidebar_full = branding_image(:logo_principal, css_class: "sidebar-brand-image sidebar-brand-image-full", alt: logo_alt) %>
  <% logo_sidebar_compact = branding_image(:logo_principal, css_class: "sidebar-brand-image sidebar-brand-image-compact", alt: logo_alt) %>
  <div class="sidebar-brand sidebar-brand-full">
    <%= link_to dashboard_path, class: "sidebar-brand-logo", aria: { label: "Ir al dashboard" } do %>
      <% if logo_sidebar_full.present? %>
        <%= logo_sidebar_full %>
        <%= logo_sidebar_compact %>
      <% else %>
        <span class="sidebar-brand-wordmark sidebar-brand-image-full" aria-hidden="true">
          <span class="sidebar-brand-wordmark-main">Cope<span>NET</span></span>
        </span>
        <span class="sidebar-brand-compact sidebar-brand-image-compact" aria-hidden="true">
          <span>C</span>
        </span>
      <% end %>
    <% end %>
    <button class="icon-button mobile-only" type="button" data-action="shell#closeSidebar">
      <%= icon("close") %>
    </button>
  </div>

  <nav class="sidebar-nav" aria-label="Main navigation">
    <% @navigation_items.each do |item| %>
      <% if item[:children].present? %>
        <% open = navigation_section_open?(item, @current_page) %>
        <div class="<%= sidebar_section_classes(open) %>">
          <button class="sidebar-section-trigger" type="button" data-action="shell#toggleSection" aria-expanded="<%= open %>">
            <span class="sidebar-item-icon"><%= icon(item[:icon]) %></span>
            <span class="sidebar-item-label"><%= item[:label] %></span>
          </button>
          <div class="sidebar-subnav">
            <% item[:children].each do |child| %>
              <%= render "shared/sidebar_item", item: child, active: child[:key] == @current_page %>
            <% end %>
          </div>
        </div>
      <% else %>
        <%= render "shared/sidebar_item", item: item, active: item[:key] == @current_page %>
      <% end %>
    <% end %>
  </nav>

  <div class="sidebar-footer">
    <div class="sidebar-promo-card">
      <strong><%= branding_texto(:promo_titulo, "Mejora tu experiencia") %></strong>
      <p><%= branding_texto(:promo_descripcion, "Descubre todas las funcionalidades avanzadas de Copenet Enterprise.") %></p>
      <%= link_to branding_texto(:promo_boton_texto, "Ver planes"), branding_texto(:promo_boton_url, "#"), class: "sidebar-promo-button" %>
    </div>
    <div class="sidebar-footer-logo" aria-label="<%= branding_texto(:footer_logo_etiqueta, 'Footer') %>">
      <% if (logo_footer = branding_image(:logo_footer, css_class: "sidebar-footer-logo-image", alt: branding_texto(:footer_logo_etiqueta, "Footer"))).present? %>
        <%= logo_footer %>
      <% else %>
        <span class="sidebar-footer-logo-mark"><%= branding_texto(:footer_logo_texto, "Derechos reservados") %></span>
      <% end %>
    </div>
  </div>
</aside>
