<%= form_with model: modulo_sistema, class: "company-form" do |form| %>
  <div class="form-actions form-actions-top">
    <%= form.submit modulo_sistema.persisted? ? "Actualizar módulo" : "Guardar módulo", class: "ui-button ui-button-primary submit-button" %>
    <%= link_to "Cancelar", modulo_sistema.persisted? ? modulos_sistema_path(modulo_sistema) : modulos_sistema_index_path, class: "ui-button ui-button-secondary" %>
  </div>

  <% if modulo_sistema.errors.any? %>
    <section class="panel form-errors">
      <div class="panel-header">
        <div>
          <h2>Corrige la información</h2>
          <p>Hay campos pendientes antes de guardar el módulo.</p>
        </div>
      </div>
      <ul class="error-list">
        <% modulo_sistema.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </section>
  <% end %>

  <section class="panel form-section">
    <div class="panel-header">
      <div>
        <h2>Información del módulo</h2>
        <p>Define cómo se registrará el módulo dentro del sistema.</p>
      </div>
    </div>

    <div class="form-grid">
      <div class="field-group">
        <%= form.label :codigo, "Código" %>
        <%= form.text_field :codigo, class: "text-input", placeholder: "USUARIOS" %>
      </div>

      <div class="field-group">
        <%= form.label :nombre, "Nombre" %>
        <%= form.text_field :nombre, class: "text-input", placeholder: "Usuarios" %>
      </div>

      <div class="field-group">
        <%= form.label :grupo, "Grupo" %>
        <%= form.text_field :grupo, class: "text-input", placeholder: "Administración" %>
      </div>

      <div class="field-group">
        <%= form.label :ruta, "Ruta" %>
        <%= form.text_field :ruta, class: "text-input", placeholder: "/usuarios" %>
      </div>

      <div class="field-group field-group-full">
        <%= form.label :descripcion, "Descripción" %>
        <%= form.text_area :descripcion, rows: 4, class: "text-input text-area", placeholder: "Describe el propósito del módulo y su alcance administrativo." %>
      </div>

      <div class="field-group checkbox-group field-group-full">
        <label class="checkbox-label">
          <%= form.check_box :activo %>
          <span>Módulo activo</span>
        </label>
      </div>
    </div>
  </section>

  <div class="form-actions">
    <%= form.submit modulo_sistema.persisted? ? "Actualizar módulo" : "Guardar módulo", class: "ui-button ui-button-primary submit-button" %>
    <%= link_to "Cancelar", modulo_sistema.persisted? ? modulos_sistema_path(modulo_sistema) : modulos_sistema_index_path, class: "ui-button ui-button-secondary" %>
  </div>
<% end %>
