<section class="page-section company-show-page">
  <section class="company-show-hero">
    <div class="company-show-identity">
      <div class="company-show-logo">
        <%= @modulo_sistema.nombre.to_s.first(2).upcase %>
      </div>

      <div class="company-show-copy">
        <div class="company-show-title-row">
          <strong class="company-show-title"><%= @modulo_sistema.nombre %></strong>

          <div class="company-show-badges">
            <%= render "shared/badge", text: @modulo_sistema.activo? ? "Activo" : "Inactivo", tone: @modulo_sistema.activo? ? "success" : "warning" %>
            <%= render "shared/badge", text: @modulo_sistema.grupo.presence || "Sin grupo", tone: "info" %>
          </div>
        </div>

        <p><%= @modulo_sistema.ruta.presence || "Sin ruta visible" %></p>
      </div>
    </div>

    <div class="company-show-actions" aria-label="Acciones de módulo">
      <%= link_to "#{icon("chevron")}<span>Volver</span>".html_safe, modulos_sistema_index_path, class: "company-show-action-button company-show-back-button", data: { turbo: false }, title: "Volver al listado", aria: { label: "Volver al listado" } %>
      <%= link_to "#{icon("pencil")}<span>Editar</span>".html_safe, edit_modulos_sistema_path(@modulo_sistema), class: "company-show-action-button company-show-action-primary", title: "Editar módulo", aria: { label: "Editar módulo" } %>
    </div>
  </section>

  <section class="panel detail-section">
    <div class="panel-header">
      <div>
        <h2>Información del módulo</h2>
      </div>
    </div>

    <div class="detail-grid">
      <div class="detail-item"><span>Código</span><strong><%= @modulo_sistema.codigo %></strong></div>
      <div class="detail-item"><span>Nombre</span><strong><%= @modulo_sistema.nombre %></strong></div>
      <div class="detail-item"><span>Grupo</span><strong><%= @modulo_sistema.grupo.presence || "Sin grupo" %></strong></div>
      <div class="detail-item"><span>Ruta</span><strong><%= @modulo_sistema.ruta.presence || "Sin ruta" %></strong></div>
      <div class="detail-item"><span>Estado</span><strong><%= @modulo_sistema.activo? ? "Activo" : "Inactivo" %></strong></div>
      <div class="detail-item detail-item-full"><span>Descripción</span><strong><%= @modulo_sistema.descripcion.presence || "Sin descripción registrada." %></strong></div>
    </div>
  </section>
</section>
