<section class="page-section">
  <div class="page-heading">
    <div>
      <p class="eyebrow">Administración</p>
      <h1>Roles y Permisos</h1>
      <p>Gestiona roles base y permisos dinámicos por módulo.</p>
    </div>
    <%= link_to "Nuevo Rol", new_rol_path, class: "ui-button ui-button-primary" %>
  </div>

  <div class="panel">
    <div class="table-shell">
      <table class="data-table">
        <thead>
          <tr>
            <th>Nombre</th>
            <th>Descripción</th>
            <th>Estado</th>
            <th>Usuarios</th>
            <th>Acciones</th>
          </tr>
        </thead>
        <tbody>
          <% @roles.each do |rol| %>
            <tr>
              <td><%= rol.nombre %></td>
              <td><%= rol.descripcion.presence || "-" %></td>
              <td><%= render "shared/badge", text: rol.activo? ? "Activo" : "Inactivo", tone: rol.activo? ? "success" : "warning" %></td>
              <td><%= rol.usuarios.count %></td>
              <td class="table-actions">
                <%= table_action_link "Ver", rol_path(rol), action: :view %>
                <%= table_action_link "Editar", edit_rol_path(rol), action: :edit %>
                <%= link_to "Permisos", permisos_rol_path(rol), class: "table-link" %>
                <%= table_action_button "Eliminar", rol_path(rol), method: :delete, action: :delete, confirm: "¿Deseas eliminar este rol?" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</section>
