<section class="page-section user-module-page user-index-page roles-index-page">
  <section class="panel filters-panel user-index-panel user-index-filters-panel">
    <%= form_with url: roles_path, method: :get, class: "filters-form" do %>
      <div class="filters-bar">
        <label class="search-shell inline-search-shell">
          <span class="search-icon"><%= icon("search") %></span>
          <%= text_field_tag :query, @filters[:query], placeholder: "Buscar por nombre o descripción" %>
        </label>
        <div class="filter-chip-list filter-select-list">
          <%= select_tag :status,
                         options_for_select([["Todos los estados", ""], ["Activos", "activo"], ["Inactivos", "inactivo"]], @filters[:status]),
                         class: "filter-select" %>
          <%= submit_tag "Aplicar filtros", class: "ui-button ui-button-primary submit-button" %>
          <%= link_to "Limpiar", roles_path, class: "ui-button ui-button-secondary" %>
        </div>
      </div>
    <% end %>
  </section>

  <section class="panel user-index-panel user-index-table-panel">
    <div class="panel-header">
      <h2>Listado de roles</h2>
      <div class="page-actions-inline">
        <%= link_to "Nuevo rol", new_rol_path, class: "ui-button ui-button-primary" %>
      </div>
    </div>

    <% if @roles.any? %>
      <div class="table-shell user-index-table-shell">
        <table class="data-table roles-table">
        <thead>
          <tr>
            <th>Nombre</th>
            <th>Descripción</th>
            <th>Estado</th>
            <th>Usuarios</th>
            <th>Acciones</th>
          </tr>
        </thead>
        <tbody>
          <% @roles.each do |rol| %>
            <tr>
              <td class="user-index-name"><%= rol.nombre %></td>
              <td class="roles-description"><%= rol.descripcion.presence || "Sin descripción" %></td>
              <td><span class="user-index-chip <%= rol.activo? ? "user-index-chip-success" : "user-index-chip-warning" %>"><%= rol.activo? ? "Activo" : "Inactivo" %></span></td>
              <td class="roles-users-count"><%= rol.usuarios.size %></td>
              <td class="table-actions">
                <%= table_action_link "Ver", rol_path(rol), action: :view %>
                <%= table_action_link "Editar", edit_rol_path(rol), action: :edit %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <% else %>
      <%= render "shared/empty_state",
                 title: @filters.values.any?(&:present?) ? "No se encontraron roles" : "No hay roles registrados",
                 description: @filters.values.any?(&:present?) ? "Ajusta la búsqueda o limpia los filtros para ver más resultados." : "Crea el primer rol para organizar accesos y permisos por módulo." %>
    <% end %>
  </section>
</section>
