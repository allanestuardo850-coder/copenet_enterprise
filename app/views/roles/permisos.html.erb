<section class="page-section">
  <%= form_with url: permisos_rol_path(@rol), method: :patch, id: "form-permisos-rol", class: "company-form" do %>
    <section class="panel product-tabs-panel">
      <div class="panel-header">
        <div>
          <h2>Permisos del rol</h2>
        </div>
        <div class="form-actions company-form-header-actions">
          <%= submit_tag "Guardar", class: "ui-button ui-button-primary submit-button" %>
          <%= link_to "Cancelar", rol_path(@rol), class: "ui-button ui-button-secondary" %>
        </div>
      </div>
    </section>

    <section class="panel form-section">
      <div class="table-shell">
        <table class="data-table permisos-table">
          <thead>
            <tr>
              <th>Módulo</th>
              <th>Ver</th>
              <th>Crear</th>
              <th>Editar</th>
              <th>Eliminar</th>
              <th>Exportar</th>
              <th>Configurar</th>
            </tr>
          </thead>
          <tbody>
            <% @modulo_sistemas.each do |modulo| %>
              <% permiso = @permisos_por_modulo[modulo.id] %>
              <tr>
                <td><%= modulo.nombre %></td>
                <td><%= check_box_tag "permisos[#{modulo.id}][puede_ver]", "1", permiso&.puede_ver? %></td>
                <td><%= check_box_tag "permisos[#{modulo.id}][puede_crear]", "1", permiso&.puede_crear? %></td>
                <td><%= check_box_tag "permisos[#{modulo.id}][puede_editar]", "1", permiso&.puede_editar? %></td>
                <td><%= check_box_tag "permisos[#{modulo.id}][puede_eliminar]", "1", permiso&.puede_eliminar? %></td>
                <td><%= check_box_tag "permisos[#{modulo.id}][puede_exportar]", "1", permiso&.puede_exportar? %></td>
                <td><%= check_box_tag "permisos[#{modulo.id}][puede_configurar]", "1", permiso&.puede_configurar? %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </section>
  <% end %>
</section>
